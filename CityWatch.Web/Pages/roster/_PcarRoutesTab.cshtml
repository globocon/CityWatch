@model CityWatch.Web.Pages.roster.BookingModel
@* Booking > PCAR tab: patrol car route profiles. Moved from Kpi Admin/Settings > "PCAR Routes" (P9 Issue 44 Step 1A).
   Behaviour lives in wwwroot/js/pcarroutes.js; handlers in Booking.Pcar.cs. *@
<div class="tab-pane fade @(Model.ActiveTab == "pcar" ? "show active" : "")" id="pcar" role="tabpanel" aria-labelledby="pcar-tab">
    <div class="card shadow-sm border-0 mt-3" style="border-radius: 12px; overflow: hidden;">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0 font-weight-bold"><i class="fa fa-car mr-2"></i>PCAR Routes</h5>
                <button type="button" class="btn btn-success" id="btnAddPcarRoute" data-toggle="modal" data-target="#pcarRouteModal">
                    <i class="fa fa-plus mr-2"></i>Add PCAR Routes
                </button>
            </div>
            <table class="table" id="pcar_routes_grid"></table>
        </div>
    </div>
</div>
