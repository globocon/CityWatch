                $('#addShiftModal').modal('show');
            });

            // Quick Cycle Shift Type on Click
            $('#roster_grid, #binder_grid').on('click', '.shift-card', function (e) {
                // Ignore if clicked on delete/edit buttons
                if ($(e.target).closest('.btn-delete-shift, .btn-edit-shift').length) return;
                
                var card = $(this);
                if (card.data('locked') === true || card.data('locked') === "true") return;

                var id = card.data('id');
                window.cycleShiftType(id, card);
            });

            window.cycleShiftType = function(id, card) {
                $.ajax({
                    url: '/roster/Booking?handler=CycleShiftType',
                    type: 'POST',
                    headers: getHeaders(),
                    data: { id: id },
                    success: function (res) {
                        if (res.success) {
                            // Find all instances of this shift in the DOM (both grids)
                            var allCards = $('.shift-card[data-id="' + id + '"]');
                            
                            // Remove all status/type classes
                            allCards.removeClass('status-pushed status-accepted status-declined type-regular type-adhoc adhoc-accepted adhoc-not-accepted type-provider');
                            
                            var typeClass = res.shiftType === 'Adhoc' ? 'type-adhoc' : 'type-regular';
                            if (allCards.data('provider') && (!allCards.data('guardid') || allCards.data('guardname') === 'External')) typeClass += ' type-provider';
                            var statusClass = 'status-pushed';
                            if (res.status === 1) statusClass = 'status-accepted';
                            if (res.status === 2) statusClass = 'status-declined';
                            
                            allCards.addClass(statusClass + ' ' + typeClass);
                            
                            // Update Card Data and DOM Attributes for all instances
                            allCards.data('shifttype', res.shiftType);
                            allCards.attr('data-shifttype', res.shiftType);
                            allCards.data('status', res.status);
                            allCards.attr('data-status', res.status);
                        } else {
                            if (res.message) alert(res.message);
                        }
                    }
                });
            };

            window.editShift = function(id, event) {
                if (event) event.stopPropagation();
                var card = $('.shift-card[data-id="' + id + '"]');
                var dayIndex = card.closest('td').data('day');
                var siteId = card.closest('td').data('site');

                $('#modalDayIndex').val(dayIndex);
                $('#modalSiteId').val(siteId);
                $('#modalShiftId').val(id);

                var guardId = card.data('guardid');
                var provider = card.data('provider');
                var payRateId = card.data('payrateid');
                var start = card.data('start');
                var end = card.data('end');

                $('#modalGuardId').empty();
                if (guardId) {
                    var guardName = card.data('guardname');
                    var newOption = new Option(guardName, guardId, true, true);
                    $('#modalGuardId').append(newOption).trigger('change');
                } else {
                    $('#modalGuardId').val(null).trigger('change');
                }

                $('#modalProviderId').empty();
                if (provider) {
                    var provOption = new Option(provider, provider, true, true);
                    $('#modalProviderId').append(provOption).trigger('change');
                } else {
                    $('#modalProviderId').val(null).trigger('change');
                }

                // Callsign
                $('#modalCallsignId').val(card.data('callsignid') || "").trigger('change');

                var adhocText = card.data('adhoctext') || "";
                if (adhocText) {
                    $('#chkAdhocOffsiteToggle').prop('checked', true);
                    $('#modalAdhocOffsiteText').val(adhocText).prop('disabled', false);
                } else {
                    $('#chkAdhocOffsiteToggle').prop('checked', false);
                    $('#modalAdhocOffsiteText').val('').prop('disabled', true);
                }

                $('#modalShiftStart').val(start);
                $('#modalShiftEnd').val(end);
                var currentType = card.data('shifttype') || 'Regular';
                var currentStatus = parseInt(card.data('status') || '0');
                var compositeType = currentType;
                
                if (currentStatus === 1) {
                    compositeType = (currentType === 'Adhoc' ? 'AdhocAccepted' : 'RegularAccepted');
                } else if (currentStatus === 2) {
                    compositeType = 'Declined';
                } else if (currentStatus === 3) {
                    compositeType = 'Cancelled';
                } else if (currentStatus === 4) {
                    compositeType = 'Missed';
                }
                
                $('#modalShiftType').val(compositeType).trigger('change');

                // Load Relief Data
                var rGuardId = card.data('reliefguardid');
                var rProvider = card.data('reliefprovider');
                var rReason = card.data('reliefreason');

                if (rGuardId) {
                    var rGuardName = card.data('reliefguardname');
                    var rOption = new Option(rGuardName, rGuardId, true, true);
                    $('#modalReliefGuardId').empty().append(rOption).trigger('change');
                } else {
                    $('#modalReliefGuardId').empty().val(null).trigger('change');
                }

                if (rProvider) {
                    var rpOption = new Option(rProvider, rProvider, true, true);
                    $('#modalReliefProviderId').empty().append(rpOption).trigger('change');
                } else {
                    $('#modalReliefProviderId').empty().val(null).trigger('change');
                }

                $('#modalReliefReason').val(rReason || "");
                $('.relief-reason-chk').prop('checked', false);
                $('#modalReliefReasonOther').hide().val('');

                if (rReason) {
                    var reasons = rReason.split(', ');
                    var matchedAny = false;
                    reasons.forEach(function(r) {
                        var chk = $('.relief-reason-chk[value="' + r + '"]');
                        if (chk.length) {
                            chk.prop('checked', true);
                            matchedAny = true;
                        }
                    });

                    // Handle custom reasons from the Mobile App (which sets ReliefReason directly to the custom string)
                    if (!matchedAny && reasons.length > 0) {
                        $('#chkOther').prop('checked', true);
                        $('#modalReliefReasonOther').show().val(rReason);
                    } else if ($('#chkOther').is(':checked')) {
                        var otherNote = card.data('reliefreasonother') || "";
                        $('#modalReliefReasonOther').show().val(otherNote);
                    }
                } else if (rGuardId || rProvider) {
                    // Default to LWOP if relief exists but no reason specified
                    $('#chkLWOP').prop('checked', true).trigger('change');
                }
                $('#modal-guard-tab').tab('show');

                if (payRateId) {
                    // We need to fetch the group ID first to populate the group dropdown
                    $.get('/roster/Booking?handler=SearchPayRates', { search: '', id: payRateId }, function(res) {
                         if (res.results && res.results.length > 0) {
                             var pr = res.results[0];
                             
                             // Set Group
                             if (pr.groupId) {
                                  var gOption = new Option(pr.groupName, pr.groupId, true, true);
                                  $('#modalPayRateGroupId').append(gOption).trigger('change');
                             } else {
                                  $('#modalPayRateGroupId').val(null).trigger('change');
                             }

                             // Set Rate
                             var rOption = new Option(pr.text, pr.id, true, true);
                             $(rOption).data('rate', pr.guardPayRate);
                             $('#modalPositionId').append(rOption).val(pr.id).trigger('change');
                             if ('@Model.RosterAccessRole' !== 'ROEditor') {
                                 $('#modalPayRate').val('$' + parseFloat(pr.guardPayRate).toFixed(2));
                             } else {
                                 $('#modalPayRate').val('');
                             }
                         }
                    });
                } else {
                    $('#modalPayRateGroupId').val(null).trigger('change');
                    $('#modalPositionId').val(null).trigger('change');
                    $('#modalPayRate').val('');
                }

                $('#addShiftModal').modal('show');
            };

            // Save Shift
            $('#btnSaveShift').on('click', function () {
                saveShiftAttempt(false);
            });

            function saveShiftAttempt(ignoreUnavail) {
                var siteId = $('#modalSiteId').val();
                var dayIndex = $('#modalDayIndex').val();
                var shiftId = $('#modalShiftId').val();

                var guardData = $('#modalGuardId').select2('data');
                var guardId = (guardData && guardData.length > 0) ? guardData[0].id : null;

                var providerData = $('#modalProviderId').select2('data');
                var providerName = (providerData && providerData.length > 0) ? providerData[0].text : null;

                var positionData = $('#modalPositionId').select2('data');
                var payRateId = (positionData && positionData.length > 0) ? positionData[0].id : null;

                var callsignId = $('#modalCallsignId').val();
                var adhocOffsiteText = $('#chkAdhocOffsiteToggle').is(':checked') ? $('#modalAdhocOffsiteText').val() : "";

                // Relief Data
                var reliefGuardData = $('#modalReliefGuardId').select2('data');
                var reliefGuardId = (reliefGuardData && reliefGuardData.length > 0) ? reliefGuardData[0].id : null;

                var reliefProviderData = $('#modalReliefProviderId').select2('data');
                var reliefProviderName = (reliefProviderData && reliefProviderData.length > 0) ? reliefProviderData[0].text : null;

                var reliefReason = $('#modalReliefReason').val();
                var reliefReasonOther = $('#modalReliefReasonOther').val();

                var shiftType = $('#modalShiftType').val();
                var shiftStatus = null; // Will be parsed on backend from shiftType

                var startTime = $('#modalShiftStart').val();
                var endTime = $('#modalShiftEnd').val();

                // Client-side Validation: Time range check (00:01 - 23:59)
                if (startTime === '00:00' || endTime === '00:00') {
                    alert('Time values of 00:00 or 24:00 are not allowed. Minimum value is 00:01 and maximum is 23:59.');
                    return;
                }

                // Client-side Validation 1: At least one selected
                if (!guardId && !providerName && shiftType !== 'Cancelled') {
                    alert('Please select either a Guard OR a Provider.');
                    return;
                }

                // Client-side Validation 2: Time check (Overnight Shift Split)
                if (startTime >= endTime) {
                    var shiftDate = new Date(currentStartDate);
                    shiftDate.setDate(shiftDate.getDate() + parseInt(dayIndex));
                    var dateStr = shiftDate.toISOString().split('T')[0];
                    
                    var nextShiftDate = new Date(shiftDate);
                    nextShiftDate.setDate(nextShiftDate.getDate() + 1);
                    var nextDateStr = nextShiftDate.toISOString().split('T')[0];

                    // Calculate Durations
                    var parts1 = startTime.split(':');
                    var h1 = parseInt(parts1[0]);
                    var m1 = parseInt(parts1[1]);
                    
                    var parts2 = endTime.split(':');
                    var h2 = parseInt(parts2[0]);
                    var m2 = parseInt(parts2[1]);

                    var totalMin1 = (23 - h1) * 60 + (59 - m1);
                    var hrs1 = Math.floor(totalMin1 / 60);
                    var mins1 = totalMin1 % 60;
                    var durationStr1 = hrs1 + 'h ' + mins1 + 'm';

                    var totalMin2 = h2 * 60 + m2 - 1;
                    var hrs2 = Math.floor(totalMin2 / 60);
                    var mins2 = totalMin2 % 60;
                    var durationStr2 = hrs2 + 'h ' + mins2 + 'm';

                    // Update Modal Content
                    $('#overnightShiftModal .modal-body').html(
                        '<p class="mb-3 text-muted">This shift crosses midnight. If you split, it will create two shifts:</p>' +
                        '<div class="alert alert-light border text-left mb-3" style="font-size: 0.9rem;">' +
                            '<div><i class="fa fa-calendar mr-2 text-primary"></i><strong>' + dateStr + '</strong>: ' + startTime + ' - 23:59 (' + durationStr1 + ')</div>' +
                            '<div class="mt-2"><i class="fa fa-calendar mr-2 text-success"></i><strong>' + nextDateStr + '</strong>: 00:01 - ' + endTime + ' (' + durationStr2 + ')</div>' +
                        '</div>' +
                        '<p class="mb-0 text-muted">Please choose how to proceed.</p>'
                    );

                    $('#overnightShiftModal').modal('show');
                    
                    $('#btnSplitShift').off('click').on('click', function() {
                        $('#overnightShiftModal').modal('hide');
                        saveSplitShiftAttempt(false);
                    });
                    return;
                }

                function saveSplitShiftAttempt(ignoreUnavailFlag) {
                    var shiftDate = new Date(currentStartDate);
                    shiftDate.setDate(shiftDate.getDate() + parseInt(dayIndex));
                    var dateStr = shiftDate.toISOString().split('T')[0];
                    
                    var nextShiftDate = new Date(shiftDate);
                    nextShiftDate.setDate(nextShiftDate.getDate() + 1);
                    var nextDateStr = nextShiftDate.toISOString().split('T')[0];

                    var startDateTime1 = dateStr + 'T' + startTime;
                    var endDateTime1 = dateStr + 'T23:59';
                    
                    var startDateTime2 = nextDateStr + 'T00:01';
                    var endDateTime2 = nextDateStr + 'T' + endTime;

                    $.ajax({
                        url: '/roster/Booking?handler=AddShift',
                        type: 'POST',
                        headers: getHeaders(),
                        data: {
                            groupId: currentGroupId,
                            siteId: siteId,
                            start: startDateTime1,
                            end: endDateTime1,
                            guardId: guardId,
                            providerName: providerName,
                            payRateId: payRateId,
                            shiftId: shiftId,
                            callsignId: callsignId,
                            reliefGuardId: reliefGuardId,
                            reliefProviderName: reliefProviderName,
                            reliefReason: reliefReason,
                            reliefReasonOther: reliefReasonOther,
                            shiftType: shiftType,
                            status: shiftStatus,
                            ignoreUnavailability: ignoreUnavailFlag
                        },
                        success: function (res1) {
                            if (res1.success) {
                                $.ajax({
                                    url: '/roster/Booking?handler=AddShift',
                                    type: 'POST',
                                    headers: getHeaders(),
                                    data: {
                                        groupId: currentGroupId,
                                        siteId: siteId,
                                        start: startDateTime2,
                                        end: endDateTime2,
                                        guardId: guardId,
                                        providerName: providerName,
                                        payRateId: payRateId,
                                        payRate: $('#modalPayRate').val(),
                                        shiftId: '', // Always new shift
                                        callsignId: callsignId,
                                        reliefGuardId: reliefGuardId,
                                        reliefProviderName: reliefProviderName,
                                        reliefReason: reliefReason,
                                        reliefReasonOther: reliefReasonOther,
                                        shiftType: shiftType,
                                        status: shiftStatus,
                                        adhocOffsiteText: adhocOffsiteText,
                                        ignoreUnavailability: ignoreUnavailFlag
                                    },
                                    success: function (res2) {
                                        if (res2.success) {
                                            $('#addShiftModal').modal('hide');
                                            if (activeTab === 'groups') loadBinderRoster(); else loadRoster();
                                        } else if (res2.isUnavailConflict) {
                                            if (confirm("Shift 1 saved.\n\nShift 2 Conflict: " + res2.message + "\n\nDo you want to proceed and roster them anyway?")) {
                                                saveSecondShiftOnly(startDateTime2, endDateTime2, true);
                                            }
                                        } else {
                                            alert('Shift 1 saved, but Shift 2 failed: ' + res2.message);
                                            if (activeTab === 'groups') loadBinderRoster(); else loadRoster();
                                        }
                                    }
                                });
                            } else if (res1.isUnavailConflict) {
                                if (confirm("Shift 1 Conflict: " + res1.message + "\n\nDo you want to proceed and roster them anyway?")) {
                                    saveSplitShiftAttempt(true);
                                }
                            } else {
                                alert(res1.message);
                            }
                        }
                    });
                }

                function saveSecondShiftOnly(start2, end2, ignoreUnavailFlag) {
                    $.ajax({
                        url: '/roster/Booking?handler=AddShift',
                        type: 'POST',
                        headers: getHeaders(),
                        data: {
                            groupId: currentGroupId,
                            siteId: siteId,
                            start: start2,
                            end: end2,
                            guardId: guardId,
                            providerName: providerName,
                            payRateId: payRateId,
                            payRate: $('#modalPayRate').val(),
                            shiftId: '',
                            callsignId: callsignId,
                            reliefGuardId: reliefGuardId,
                            reliefProviderName: reliefProviderName,
                            reliefReason: reliefReason,
                            reliefReasonOther: reliefReasonOther,
                            shiftType: shiftType,
                            status: shiftStatus,
                            adhocOffsiteText: adhocOffsiteText,
                            ignoreUnavailability: ignoreUnavailFlag
                        },
                        success: function (res) {
                            if (res.success) {
                                $('#addShiftModal').modal('hide');
                                if (activeTab === 'groups') loadBinderRoster(); else loadRoster();
                            } else {
                                alert('Shift 2 failed: ' + res.message);
                                if (activeTab === 'groups') loadBinderRoster(); else loadRoster();
                            }
                        }
                    });
                }

                // Client-side Validation 3: Relief Reason Validation
                if (reliefGuardId || reliefProviderName) {
                    if (!reliefReason) {
                        alert('Please select a Reason for Relief.');
                        $('#modal-relief-tab').tab('show');
                        return;
                    }
                    if ($('#chkOther').is(':checked') && !reliefReasonOther.trim()) {
                        alert('Please specify the "Other" relief reason.');
                        $('#modalReliefReasonOther').focus();
                        return;
                    }
                }

                // Calculate actual DateTimes
                var shiftDate = new Date(currentStartDate);
                shiftDate.setDate(shiftDate.getDate() + parseInt(dayIndex));
                var dateStr = shiftDate.toISOString().split('T')[0];
                var startDateTime = dateStr + 'T' + startTime;
                var endDateTime = dateStr + 'T' + endTime;

                $.ajax({
                    url: '/roster/Booking?handler=AddShift',
                    type: 'POST',
                    headers: getHeaders(),
                    data: {
                        groupId: currentGroupId,
                        siteId: siteId,
                        start: startDateTime,
                        end: endDateTime,
                        guardId: guardId,
                        providerName: providerName,
                        payRateId: payRateId,
                        payRate: $('#modalPayRate').val(),
                        shiftId: shiftId,
                        callsignId: callsignId,
                        reliefGuardId: reliefGuardId,
                        reliefProviderName: reliefProviderName,
                        reliefReason: reliefReason,
                        reliefReasonOther: reliefReasonOther,
                        shiftType: shiftType,
                        status: shiftStatus,
                        adhocOffsiteText: adhocOffsiteText,
                        ignoreUnavailability: ignoreUnavail
                    },
                    success: function (res) {
                        if (res.success) {
                            $('#addShiftModal').modal('hide');
                            if (activeTab === 'groups') loadBinderRoster(); else loadRoster();
                        } else if (res.isUnavailConflict) {
                            if (confirm(res.message + "\n\nDo you want to proceed and roster them anyway?")) {
                                saveShiftAttempt(true);
                            }
                        } else {
                            alert(res.message);
                        }
                    }
                });
            }


