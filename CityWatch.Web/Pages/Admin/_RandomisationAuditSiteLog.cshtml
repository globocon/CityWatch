@using CityWatch.Data.Models;
@using CityWatch.Web.Helpers;
@using CityWatch.Web.Services;
@inject IViewDataService viewDataService
@model CityWatch.Web.Pages.Admin.AuditSiteLogModel

@* Patrol Randomisation scan log (ClientSitePatrolRandomisationLogs, DbScript/387). Script: guardlog.js "Randomisation". *@
<form id="form_randomisation_auditlog_request" method="post" class="border-bottom">
    <div class="form-row">
        <div class="form-group col-md-3">
            <label class="mx-1">Client Type</label>
            <select class="form-control randomisationmultiselect" multiple="multiple" id="randomisationClientType">
                @{
                    var userClientTypes = viewDataService.GetUserClientTypesHavingAccess(AuthUserHelper.LoggedInUserId);
                    if (Model.ClientTypeId != 0)
                        userClientTypes = userClientTypes.Where(x => x.Id == Model.ClientTypeId).ToList();
                    foreach (var clientType in userClientTypes.OrderBy(clientType => clientType.Name))
                    {
                        var countClientType = viewDataService.GetClientTypeCount(clientType.Id);
                        if (Model.ClientTypeId != 0)
                        {
                            <option value="@clientType.Name" selected>@clientType.Name (@countClientType)</option>
                        }
                        else
                        {
                            <option value="@clientType.Name">@clientType.Name (@countClientType)</option>
                        }
                    }
                }
            </select>
        </div>
        <div class="form-group col-md-3">
            <label class="mx-1">Client Site</label>
            <select class="form-control mx-1 randomisationmultiselect" multiple="multiple" id="randomisationClientSiteId"></select>
        </div>
        <div class="form-group col-md-2">
            <label class="mx-1" for="randomisationAuditFromDate">From Date</label>
            <input type="date" class="form-control" id="randomisationAuditFromDate" />
        </div>
        <div class="form-group col-md-2">
            <label class="mx-1" for="randomisationAuditToDate">To Date</label>
            <input type="date" class="form-control" id="randomisationAuditToDate">
        </div>
    </div>

    <input type="hidden" asp-for="@Model.PatrolRandomisationReportRequest.ClientSiteId" />
    <input type="hidden" asp-for="@Model.PatrolRandomisationReportRequest.LogFromDate" />
    <input type="hidden" asp-for="@Model.PatrolRandomisationReportRequest.LogToDate" />
    <input type="hidden" asp-for="@Model.PatrolRandomisationReportRequest.Status" />

    <div class="row">
        <div class="col-md-5">
            <div class="row">
                <div class="col-md-12 mt-1">
                    <label style="color:#0366d6">Scan Downselect</label>
                    <hr class="mt-0" />
                </div>
            </div>
            <div class="row">
                <div class="form-group col-md-7">
                    <label>Result</label>
                    <select class="form-control randomisationmultiselect" multiple="multiple" id="randomisationStatus">
                        @foreach (var status in Enum.GetValues<PatrolRandomisationLogStatus>())
                        {
                            <option value="@((int)status)">@status</option>
                        }
                    </select>
                </div>
                <div class="form-group col-md-5">
                    <label>Scanning</label>
                    <select class="form-control" asp-for="@Model.PatrolRandomisationReportRequest.ScanMode">
                        <option value="">All</option>
                        <option value="online">Online</option>
                        <option value="offline">Offline</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="row">
                <div class="col-md-12 mt-1">
                    <label style="color:#0366d6">Guard Downselect</label>
                    <hr class="mt-0" />
                </div>
            </div>
            <div class="row">
                <div class="form-group col-md-6">
                    <label>Guard Name</label>
                    <input type="text" class="form-control" asp-for="@Model.PatrolRandomisationReportRequest.GuardName" />
                </div>
                <div class="form-group col-md-6">
                    <label>Guard Security No</label>
                    <input type="text" class="form-control" asp-for="@Model.PatrolRandomisationReportRequest.GuardSecurityNo" />
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="form-group col-auto ml-auto">
            <div class="d-flex justify-content-end align-items-center flex-wrap">
                <button type="button" class="btn btn-primary mr-5" id="btnGenerateRandomisationReport">
                    View Report
                </button>
                <img class="mr-2" src="../images/icons/Excel_2025.svg" height="32" />
                <button type="button" class="btn btn-primary" id="btnDownloadRandomisationExcel">
                    <i class="fa fa-arrow-down mr-1"></i>Excel
                </button>
            </div>
        </div>
    </div>
</form>
<div class="full-width">
    <div class="row mt-3">
        <div class="col-md-12">
            @* Totals for the rows shown; filled by guardlog.js after each run. *@
            <div id="randomisationSummary" class="d-none flex-wrap mb-2"></div>
            <table class="table table-bordered table-sm" width="100%" id="tbl_randomisation_site_log">
                <thead>
                    <tr>
                        <th style="display:none"></th>
                        <th>Day</th>
                        <th>Window</th>
                        <th>Guard</th>
                        <th>User</th>
                        <th>From Tag</th>
                        <th>From Time</th>
                        <th>Assigned Tag</th>
                        <th>Assigned Time</th>
                        <th>Scanned Tag</th>
                        <th>Scanned UID</th>
                        <th>Scanned Time</th>
                        <th>Online / Offline</th>
                        <th>Response</th>
                        <th>Result</th>
                    </tr>
                </thead>
            </table>
            <small class="text-muted">
                Times are site local. Completed = guard struck the assigned tag; Skipped = guard struck a different tag;
                Missed = window closed with no strike; Unguided = strike in the window with no instruction to follow (e.g. offline);
                Cancelled = randomisation was switched off.
            </small>
        </div>
    </div>
</div>
