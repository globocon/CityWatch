@page "/RoosterHub"
@using CityWatch.Web.Helpers
@model CityWatch.Web.Pages.Admin.RosterModel
@{
   
    ViewData["Title"] = Model.ClientNameTitle + " | ROSTERS";
    ViewData["PageName"] = CityWatch.Web.Helpers.PageNameHelper.Roster;

}
<div class="row  text-center" style="padding-top:90px;">




 

        <div class="col-sm-3">
            <h3>BOOKING</h3>
            <div style="width:149px;border:3px solid grey;padding:50px;margin:20px auto;">
                @if (AuthUserHelper.IsAdminUserLoggedIn || AuthUserHelper.IsAdminGlobal || AuthUserHelper.IsAdminPowerUser)
                {
                    <a href="/roster/Booking" id="AnBooking">
                        <img src="~/images/CalendarWithHand.png" class="center" />
                    </a>
                }
                else
                {
                    <a href="javascript:void(0);" id="AnBookingAuth" data-toggle="modal" data-target="#mdlAuthBookingAccess">
                        <img src="~/images/CalendarWithHand.png" class="center" />
                    </a>
                }
            </div>
            <div class="font-weight-bold text-muted" style="margin-top: -15px; font-size: 0.85rem;">(Admin Only)</div>
        </div>

        <!-- ROSTERS -->
        <div class="col-sm-3">
            <h3>ROSTERS</h3>
            <div style="width:149px;border:3px solid grey;padding:50px;margin:20px auto;">
                <a href="javascript:void(0);" id="BtnRosterAuthSelector" data-toggle="modal" data-target="#mdlAuthGuardForRosterSelector">
                    <img src="~/images/calender.png" class="center" />
                </a>
            </div>
        </div>

        <!-- PCAR ROUTE -->
        <div class="col-sm-3">
            <h3>PCAR ROUTE</h3>
            <div style="width:149px;border:3px solid grey;padding:50px;margin:20px auto; text-align:center;">
                <a href="javascript:void(0);" id="AnPcarCars">
                    <i class="fa fa-car" style="font-size:48px;"></i>
                </a>
            </div>
        </div>

        <!-- TIMESHEETS -->
        <div class="col-sm-3">
            <h3>TIMESHEETS</h3>
            <div style="width:149px;border:3px solid grey;padding:50px;margin:20px auto;">
                <a href="javascript:void(0);" id="Ancompanysop2" data-toggle="modal" data-target="#mdlAuthGuardForSopDownload">
                    <img src="~/images/Timesheet.jpg" class="center" />
                </a>
            </div>
        </div>

</div>

    

