    function loadGuardRoster() {
        if (!currentGuardSiteId || !guardRosterStartDate) return;

        var parts = guardRosterStartDate.split('-');
        var end = new Date(parts[0], parts[1] - 1, parts[2]);
        end.setDate(end.getDate() + 6);
        $('#guardWeekRangeText').html(formatGuardDate(new Date(parts[0], parts[1] - 1, parts[2])) + ' - ' + formatGuardDate(end));

        var tbody = $('#guard_roster_body');
        var thead = $('#guard_roster_header tr');
        var tfoot = $('#guard_roster_footer');
        
        tbody.html('<tr><td colspan="8" class="text-center py-5"><i class="fa fa-spinner fa-spin fa-3x text-primary opacity-25"></i><p class="mt-3 text-muted font-weight-bold">LOADING ROSTER...</p></td></tr>');
        tfoot.hide();

        $.ajax({
            url: '/roster/GuardRosterAction?handler=LoadRosterForSite',
            type: 'GET',
            data: { siteId: currentGuardSiteId, startDate: guardRosterStartDate },
            success: function (res) {
                tbody.empty();
                thead.find('th:not(:first-child)').remove();
                tfoot.find('td:not(:first-child)').remove();

                if (!res.results || res.results.length === 0) {
                    $('#guardRosterEmpty').removeClass('d-none');
                    $('#guard_roster_grid').addClass('d-none');
                    return;
                }
                $('#guardRosterEmpty').addClass('d-none');
                $('#guard_roster_grid').removeClass('d-none');
                tfoot.show();

                // Inject Day Headers (Arranged like Booking)
                var p = guardRosterStartDate.split('-');
                var d = new Date(p[0], p[1] - 1, p[2]);
                for (var i = 0; i < 7; i++) {
                    var dayDate = new Date(d);
                    dayDate.setDate(d.getDate() + i);
                    
                    var ph = isPublicHolidayAtDate(dayDate.getTime(), res.holidays, res.siteState);
                    var phIcon = ph ? phIconSvg : "";
                    var phTitle = ph ? ph.reason : "";
                    
                    var dateStr = dayDate.toLocaleDateString('en-GB', { weekday: 'short', day: '2-digit', month: 'short' }).toUpperCase();
                    thead.append('<th style="width: 12.14%;" title="' + phTitle + '"><div>' + dateStr + phIcon + '</div></th>');
                    tfoot.children('tr').append('<td class="p-0"><div class="total-item"><span class="total-label">Daily Total</span><span class="total-value font-weight-bold" id="daily_total_' + i + '">0h</span></div></td>');
                }

                 lastGuardRosterData = res;

                // Update Filter Dropdown (Add unique guards found in data)
                var filterSelect = $('#adminGuardFilter');
                var currentSelection = filterSelect.val();
                filterSelect.find('option:not([value="ALL"])').remove();
                
                var filterGuards = [];
                res.results.forEach(function(row) {
                    row.days.forEach(function(dayShifts) {
                        dayShifts.forEach(function(s) {
                            var gId = s.reliefGuardId || s.guardId;
                            var gName = s.reliefGuardName || s.guardName;
                            var k = gId ? ("G" + gId) : ("P" + gName);
                            if (gName && !filterGuards.find(x => x.key === k)) {
                                filterGuards.push({ key: k, name: gName });
                            }
                        });
                    });
                });
                
                filterGuards.sort((a,b) => a.name.localeCompare(b.name)).forEach(g => {
                    filterSelect.append('<option value="' + g.key + '">' + g.name + '</option>');
                });
                filterSelect.val(currentSelection || "ALL");

                var filterVal = filterSelect.val();
                var grandTotalHours = 0;
                var grandTotalCost = 0;
                var dailyTotalHours = [0,0,0,0,0,0,0];
                var dailyTotalCost = [0,0,0,0,0,0,0];

                res.results.forEach(function (row) {
                    var rowHtml = '<tr>' +
                        '<td class="align-top px-3 text-left d-flex flex-column" style="min-height: 150px;">' + 
                            '<div>' + 
                                '<div class="guard-site-name">' + row.siteName + '</div>' + 
                                '<div class="guard-client-type">' + row.clientTypeName + '</div>' + 
                            '</div>' + 
                            '<div class="admin-status-grid-display mt-auto pb-2"></div>' + 
                        '</td>';

                    row.days.forEach(function (dayShifts, index) {
                        var ps = guardRosterStartDate.split('-');
                        var loopDate = new Date(ps[0], ps[1]-1, ps[2]);
                        loopDate.setDate(loopDate.getDate() + index);
                        
                        var ph = isPublicHolidayAtDate(loopDate.getTime(), res.holidays, res.siteState);
                        var phClass = ph ? "guard-ph-highlight" : "";
                        var phReason = ph ? ph.reason : "";
                        
                        var weekendClass = "";
                        if (loopDate.getDay() === 6) weekendClass = "guard-sat-highlight";
                        else if (loopDate.getDay() === 0) weekendClass = "guard-sun-highlight";
                        
                        rowHtml += '<td class="guard-day-cell ' + phClass + ' ' + weekendClass + '" title="' + phReason + '">';
                        
                        dayShifts.forEach(function (s) {
                            var guardId = s.reliefGuardId || s.guardId;
                            var guardName = s.reliefGuardName || s.guardName;
                            var key = guardId ? ("G" + guardId) : ("P" + guardName);
                            
                            // Apply Filtering
                            if (filterVal !== "ALL" && filterVal !== key) return;

                            var duration = parseFloat(s.durationHours);
                            var activeRate = (adminRateType == 'sell' ? s.sellRate : s.buyRate);
                            var cost = duration * activeRate;

                            dailyTotalHours[index] += duration;
                            grandTotalHours += duration;
                            dailyTotalCost[index] += cost;
                            grandTotalCost += cost;

                            var statusClass = 'status-pushed';
                            if (s.status === 1) statusClass = 'status-accepted';
                            if (s.status === 2) statusClass = 'status-declined';

                            var typeClass = 'type-regular';
                            if (s.shiftType === 'Adhoc') typeClass = 'type-adhoc';

                             var isRelief = s.reliefGuardId || s.reliefProviderName;
                            var belongsToLoggedGuard = loggedGuardId && (s.guardId === loggedGuardId || s.reliefGuardId === loggedGuardId);
                            
                            // Check if date is today or future
                            var shiftDate = new Date(s.shiftDate || loopDate);
                            var today = new Date();
                            today.setHours(0,0,0,0);
                            var isFutureOrToday = shiftDate >= today;

                            rowHtml += '<div class="guard-shift-card clickable-shift ' + (isRelief ? 'shift-relief ' : '') + statusClass + ' ' + typeClass + '" ' +
                                'data-shift-id="' + s.id + '" data-status="' + s.status + '" data-type="' + s.shiftType + '" data-guard-id="' + s.guardId + '" data-relief-guard-id="' + (s.reliefGuardId || '') + '" data-is-future="' + isFutureOrToday + '">' +
                                (belongsToLoggedGuard ? '<i class="fa fa-pencil guard-edit-icon" title="Your Shift"></i>' : '') +
                                '<div class="text-truncate font-weight-bold">' + 
                                    (isRelief ? '<span class="guard-relief-badge">R</span>' : '<i class="fa fa-user mr-1 small opacity-75"></i>') + 
                                    (s.reliefGuardName || s.reliefProviderName || s.guardName) + 
                                '</div>' +
                                (s.reliefReason ? '<div class="text-truncate mt-1 italic opacity-75" style="font-size: 8px;">[' + s.reliefReason + '] ' + truncateGuardName(s.guardName, 12) + '</div>' : '') +
                                '<div class="guard-shift-license">LIC: ' + (s.reliefGuardId ? (s.reliefGuardLicense || "N/A") : s.guardLicense) + '</div>' +
                                '<div class="guard-shift-time">' + s.shiftStart + ' - ' + s.shiftEnd + ' (' + s.durationHours.toString().replace(/\.00$/, "") + 'h)</div>' +
                                (isAdminSupplierOn ? 
                                    '<div style="font-weight: 800; color: #0056b3; font-size: 11px; margin-top: 1px; text-shadow: 0 0 1px rgba(0,0,0,0.1);">' + (s.reliefGuardId ? s.reliefProviderName : s.guardProvider) + (s.callsignName ? ' (' + s.callsignName + ')' : '') + '</div>' : 
                                    (!isAdminSupplierOn && s.callsignName ? '<div class="mt-1 font-weight-bold" style="font-size: 9px; color: inherit; opacity: 0.8;">' + s.callsignName + '</div>' : '')
                                ) +
                                (isAdminFinancialsOn ? 
                                    '<div style="font-weight: 800; color: #ff3d00; font-size: 13px; margin-top: 2px; text-shadow: 0 0 1px rgba(0,0,0,0.1);">$ ' + ((adminRateType == 'sell' ? s.sellRate : s.buyRate) * duration).toFixed(2) + '</div>' : 
                                    ''
                                );
                            
                            rowHtml += '</div>';
                        });
                        rowHtml += '</td>';
                    });

                    rowHtml += '</tr>';
                    tbody.append(rowHtml);
                });

                // Show Status Stamp in Grid
                if (res.status) {
                    currentRosterStatus = res.status;
                    updateGridStatusDisplay(res.status);
                    if (isAdminRoster) {
                        $('#adminRosterStatus').val(res.status);
                    }
                }

                // Update Totals
                if (isAdminFinancialsOn) {
                    $('#guard_weekly_grand_total').html('<span style="font-weight: 800; color: #ff3d00;">$ ' + grandTotalCost.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) + '</span>');
                    $('.total-label:contains("Weekly Total")').text("Weekly Pay");
                    for(var i=0; i<7; i++) {
                        $('#daily_total_' + i).html('<span style="font-weight: 800; color: #ff3d00;">$ ' + dailyTotalCost[i].toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) + '</span>');
                    }
                } else {
                    $('#guard_weekly_grand_total').text(grandTotalHours.toFixed(2).replace(/\.00$/, "") + "h");
                    $('.total-label:contains("Weekly Pay")').text("Weekly Total");
                    for(var i=0; i<7; i++) {
                        $('#daily_total_' + i).text(dailyTotalHours[i].toFixed(2).replace(/\.00$/, "") + "h");
                    }
                }
                
                checkRemunerationVisibility();
            },
            error: function() {
                tbody.html('<tr><td colspan="8" class="text-center py-5 text-danger font-weight-bold"><i class="fa fa-exclamation-triangle mr-2"></i> FAILED TO LOAD ROSTER DATA</td></tr>');
            }
        });
    }

    function isPublicHolidayAtDate(time, holidays, state) {
        if (!holidays) return null;
        var date = new Date(time);
        var dYear = date.getFullYear();
        var dMonth = date.getMonth();
        var dDay = date.getDate();
        
        // Use local date string YYYY-MM-DD to avoid timezone shift issues with toISOString()
        var dStr = dYear + '-' + String(dMonth + 1).padStart(2, '0') + '-' + String(dDay).padStart(2, '0');
        var siteState = (state || "").trim().toUpperCase();
        
        for (var i = 0; i < holidays.length; i++) {
            var h = holidays[i];
            var hS = new Date(h.startDate);
            var hE = new Date(h.expiryDate);
            var hSStr = hS.getFullYear() + '-' + String(hS.getMonth() + 1).padStart(2, '0') + '-' + String(hS.getDate()).padStart(2, '0');
            var hEStr = hE.getFullYear() + '-' + String(hE.getMonth() + 1).padStart(2, '0') + '-' + String(hE.getDate()).padStart(2, '0');
            
            var isMatch = false;
            // 1. Exact date range match (using local date strings)
            if (dStr >= hSStr && dStr <= hEStr) {
                isMatch = true;
            }
            // 2. RepeatYearly match (Month/Day)
            else if (h.repeatYearly && hS.getMonth() === dMonth && hS.getDate() === dDay) {
                isMatch = true;
            }

            if (isMatch) {
                if (!h.states || h.states.length === 0 || h.states.indexOf("ALL") !== -1 || h.states.indexOf(siteState) !== -1) {
                    return h;
                }
            }
        }
        return null;
    }

    function formatGuardDate(date) {
        return date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
    }

    // Click-to-cycle status logic
    $(document).on('click', '.clickable-shift', function() {
        var card = $(this);
        var shiftId = card.data('shift-id');
        var currentStatus = parseInt(card.data('status'));
        var isFuture = card.data('is-future') === true;

        if (isAdminRoster) {
            // Admin Cycle: Pushed (0) -> Accepted (1) -> Declined (2) -> Pushed (0)
            var nextStatus = (currentStatus + 1) % 3;
            updateShiftStatusViaWeb(shiftId, nextStatus, card);
        } else {
            // Guard Logic
            if (!isFuture || !loggedGuardId) return;

            var shiftGuardId = card.data('guard-id') ? parseInt(card.data('guard-id')) : null;
            var shiftReliefId = card.data('relief-guard-id') ? parseInt(card.data('relief-guard-id')) : null;
            var belongsToMe = (shiftGuardId === loggedGuardId) || (shiftReliefId === loggedGuardId);

            if (belongsToMe) {
                if (currentStatus === 0) { // Orange -> Green (Accept)
                    processGuardShiftAction(shiftId, 1, 0);
                } else if (currentStatus === 1) { // Green -> Black (Cancel)
                    processGuardShiftAction(shiftId, 2, 1);
                } else if (currentStatus === 2) { // Black -> Orange (Reset)
                    processGuardShiftAction(shiftId, 0, 2);
                }
            } else {
                // Not my shift - can only pickup if Black (Declined)
                if (currentStatus === 2) {
                    processGuardShiftAction(shiftId, 1, 2, true);
                }
            }
        }
    });

    function updateShiftStatusViaWeb(shiftId, newStatus, card) {
        $.ajax({
            url: '/api/GuardSecurityNumber/UpdateShiftStatus',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                shiftId: shiftId,
                newStatus: newStatus,
                expectedStatus: parseInt(card.data('status')),
                callingGuardId: 1, // System/Admin ID for web updates
                reason: newStatus === 2 ? "Cancelled via Web Dashboard" : ""
            }),
            success: function(res) {
                if (res.isSuccess) {
                    // Update card locally for immediate feedback
                    card.data('status', newStatus);
                    
                    // Remove all status classes
                    card.removeClass('status-pushed status-accepted status-declined adhoc-pushed adhoc-accepted');
                    
                    var isAdhoc = card.data('type') === 'Adhoc';
                    var statusClass = 'status-pushed';
                    if (newStatus === 1) statusClass = 'status-accepted';
                    if (newStatus === 2) statusClass = 'status-declined';
                    
                    var typeClass = isAdhoc ? (newStatus === 1 ? 'adhoc-accepted' : 'adhoc-pushed') : '';
                    card.addClass(statusClass + ' ' + typeClass);
                } else {
                    alert(res.message || "Failed to update shift status.");
                }
            }
        });
    }

    function processGuardShiftAction(shiftId, newStatus, expectedStatus, isReliefPickup) {
        if (newStatus === 2) { // Cancel (Green -> Black)
            // Show custom cancellation modal
            $('input[name="cancelReason"]').prop('checked', false);
            $('#cancelReasonOtherArea').hide();
            $('#txtCancelReasonOther').val('');
            $('#btnConfirmCancellation').data('shift-id', shiftId).data('expected-status', expectedStatus);
            $('#guardCancellationModal').modal('show');
            return;
        }

        if (isReliefPickup) {
            if (!confirm("Do you want to add as relief guard?")) return;
        } else if (newStatus === 0) {
            if (!confirm("Do you want to reset this shift to Pushed status?")) return;
        }

        executeShiftStatusUpdate(shiftId, newStatus, expectedStatus, "");
    }

    function executeShiftStatusUpdate(shiftId, newStatus, expectedStatus, reason) {
        $('#loader').show();
        $.ajax({
            url: '/api/GuardSecurityNumber/UpdateShiftStatus',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                shiftId: shiftId,
                newStatus: newStatus,
                expectedStatus: expectedStatus,
                callingGuardId: loggedGuardId,
                reason: reason
            }),
            success: function(res) {
                if (res.isSuccess) {
                    loadGuardRoster(); 
                } else {
                    alert(res.message || "Action failed. Please try again.");
                }
            },
            complete: function() {
                $('#loader').hide();
            }
        });
    }

    function truncateGuardName(str, num) {
        if (!str) return "";
        if (str.length <= num) return str;
        return str.slice(0, num) + '..';
    }
</script>
