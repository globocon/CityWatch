            var token = $('input[name="__RequestVerificationToken"]').val();
            $.ajax({
                url: '/roster/Booking?handler=DeleteShift',
                type: 'POST',
                data: { id: shiftId },
                headers: { "RequestVerificationToken": token },
                success: function(res) {
                    if (res.success) {
                        loadGuardRoster();
                    } else {
                        alert('Failed to delete: ' + res.message);
                    }
                }
            });
        }
    }

    // Click-to-cycle status logic for Guard Roster
    // FLOW SUMMARY (as requested 24/04/2026):
    // 1. Owner clicks Orange (Pending) -> Status 1 (Green/Accepted) [One-click]
    // 2. Owner clicks Green (Accepted) -> Status 2 (Black/Cancelled) [Reason Modal]
    // 3. Owner clicks Black (Cancelled) -> Status 1 (Green/Accepted) [Re-Accept Prompt]
    // 4. Non-Owner clicks Black (Cancelled) -> Status 1 (Purple/Relief) [Relief Prompt]
    // * Note: Guards cannot reset back to Orange (Pending) once interacted.
    $(document).on('click', '.clickable-shift', function(e) {
        if ($(e.target).closest('.btn-delete-shift, .btn-edit-shift').length) return;
        var card = $(this);
        var shiftId = card.data('shift-id');
        var currentStatus = parseInt(card.data('status'));
        var isFuture = card.data('is-future') === true;

        if (isEditMode) {
            // Use the same endpoint as Booking.cshtml to correctly cycle shift type/status
            cycleShiftTypeGuardRoster(shiftId, card);
        } else {
            // Guard Logic
            if (!isFuture || !loggedGuardId) return;

            var shiftGuardId = card.data('guard-id') ? parseInt(card.data('guard-id')) : null;
            var shiftReliefId = card.data('relief-guard-id') ? parseInt(card.data('relief-guard-id')) : null;
            
            // Ownership logic: If relief exists, only relief guard can edit. Otherwise, main guard.
            var belongsToMe = loggedGuardId && (
                shiftReliefId ? (shiftReliefId === loggedGuardId) : (shiftGuardId === loggedGuardId)
            );

            if (belongsToMe) {
                if (currentStatus === 0) { // Orange (Pending) -> Green (Accept)
                    processGuardShiftAction(shiftId, 1, 0);
                } else if (currentStatus === 1) { // Green (Accepted) -> Black (Cancel)
                    processGuardShiftAction(shiftId, 2, 1);
                } else if (currentStatus === 2) { // Black (Cancelled) -> Green (Re-Accept)
                    processGuardShiftAction(shiftId, 1, 2);
                }
            } else {
                // Not my shift - can only pickup if Black (Declined)
                if (currentStatus === 2) {
                    processGuardShiftAction(shiftId, 1, 2, true);
                }
            }
        }
    });

    function cycleShiftTypeGuardRoster(id, card) {
        $.ajax({
            url: '/roster/Booking?handler=CycleShiftType',
            type: 'POST',
            headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
            data: { id: id },
            success: function (res) {
                if (res.success) {
                    // Find all instances of this shift in the DOM
                    var allCards = $('.guard-shift-card[data-shift-id="' + id + '"]');
                    
                    // Remove all status/type classes
                    allCards.removeClass('status-pushed status-accepted status-declined type-regular type-adhoc adhoc-accepted adhoc-not-accepted type-provider');
                    
                    var typeClass = res.shiftType === 'Adhoc' ? 'type-adhoc' : 'type-regular';
                    if (allCards.data('provider-name') && (!allCards.data('guard-id') || allCards.data('guard-name') === 'External')) typeClass += ' type-provider';
                    var statusClass = 'status-pushed';
                    if (res.status === 1) statusClass = 'status-accepted';
                    if (res.status === 2) statusClass = 'status-declined';
                    if (res.status === 3) statusClass = 'status-cancelled';
                    
                    allCards.addClass(statusClass + ' ' + typeClass);
                    
                    // Update Card Data and DOM Attributes for all instances
                    allCards.data('type', res.shiftType);
                    allCards.attr('data-type', res.shiftType);
                    allCards.data('status', res.status);
                    allCards.attr('data-status', res.status);
                } else {
                    if (res.message) alert(res.message);
                }
            }
        });
    }

    /**
     * Handles specific guard actions based on current status.
     * Flow: Orange -> Green (Accept), Green -> Black (Cancel), Black -> Green (Re-Accept) or Purple (Relief)
     */
    function processGuardShiftAction(shiftId, newStatus, expectedStatus, isReliefPickup) {
        if (newStatus === 2) { // Cancel (Green -> Black)
            // Show custom cancellation modal
            $('input[name="cancelReason"]').prop('checked', false);
            $('#cancelReasonOtherArea').hide();
            $('#txtCancelReasonOther').val('');
            $('#btnConfirmCancellation').data('shift-id', shiftId).data('expected-status', expectedStatus);
            $('#guardCancellationModal').modal('show');
            return;
        }

        if (isReliefPickup) {
            if (!confirm("Do you want to add as relief guard?")) return;
        } else if (newStatus === 1 && expectedStatus === 2) {
            if (!confirm("Do you want to re-accept this shift?")) return;
        } else if (newStatus === 0) {
            // Guards shouldn't be able to reset to 0 based on new rules, but keeping for admin/system safety
            if (!confirm("Do you want to reset this shift to Pending status?")) return;
        }

        executeShiftStatusUpdate(shiftId, newStatus, expectedStatus, "");
    }

    function executeShiftStatusUpdate(shiftId, newStatus, expectedStatus, reason) {
        $('#loader').show();
        $.ajax({
            url: '/api/GuardSecurityNumber/UpdateShiftStatus',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                shiftId: shiftId,
                newStatus: newStatus,
                expectedStatus: expectedStatus,
                callingGuardId: loggedGuardId,
                reason: reason
            }),
            success: function(res) {
                if (res.isSuccess) {
                    loadGuardRoster(); 
                } else {
                    alert(res.message || "Action failed. Please try again.");
                }
            },
            complete: function() {
                $('#loader').hide();
            }
        });
    }

    function truncateGuardName(str, num) {
        if (!str) return "";
        if (str.length <= num) return str;
        return str.slice(0, num) + '..';
    }
</script>
