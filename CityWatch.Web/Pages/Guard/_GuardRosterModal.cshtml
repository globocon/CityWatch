<div class="modal fade" id="guardCancellationModal" tabindex="-1" role="dialog" aria-hidden="true" style="z-index: 1100;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-dark text-white p-3">
                <h6 class="modal-title font-weight-bold"><i class="fa fa-exclamation-triangle mr-2 text-warning"></i>Reason for Relief</h6>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">&times;</button>
            </div>
            <div class="modal-body p-4">
                <p class="small text-muted mb-3 font-weight-bold text-uppercase">Please select a reason for cancelling this shift:</p>
                
