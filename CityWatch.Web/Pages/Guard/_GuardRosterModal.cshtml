<script>
    var guardRosterStartDate = null;
    var currentGuardSiteId = null;
    var currentRosterGroupId = null;
    var loggedGuardId = null;
    var isAdminRoster = false;
    var isAdminFinancialsOn = false;
    var isAdminSupplierOn = false;
    var adminRateType = 'guard'; // 'guard' or 'sell'
    var currentRosterStatus = 'Live';
    var lastGuardRosterData = null;
    var isROEditor = false;
    var isEditMode = false;
    
    // Public Holiday Orange Sun SVG
    const phIconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512" style="width: 16px; height: 16px; fill: #FFA500; vertical-align: middle; margin-left: 4px;"><path d="M608 384h-141.2c-7.1 0-14.1-2.1-20.1-6.1L382.5 335.1l-64.2-42.8L192 384H32c-17.7 0-32-14.3-32-32s14.3-32 32-32h155.6l69.8-46.5c10.3-6.9 23.9-6.9 34.2 0l64.4 42.9 85.5 28.5H608c17.7 0 32 14.3 32 32s-14.3 32-32 32zM32 448c-17.7 0-32-14.3-32-32s14.3-32 32-32h576c17.7 0 32 14.3 32 32s-14.3 32-32 32H32zM280.4 224l-59.3-59.3-59.3 59.3 59.3 59.3 59.3-59.3zM256 0c-43.8 0-82.6 25.1-102.3 62.4l-31.1-10.4c-8.4-2.8-17.5 1.7-20.3 10.1s1.7 17.5 10.1 20.3l31.1 10.4c.1 3.5.3 7 1.1 10.4 12.4 56.6 62.1 98.8 121.4 98.8s109-42.2 121.4-98.8c.8-3.5.9-7 1.1-10.4l31.1-10.4c8.4-2.8 12.9-11.9 10.1-20.3s-11.9-12.9-20.3-10.1l-31.1 10.4C338.6 25.1 299.8 0 256 0z"/></svg>`;

    $(document).ready(function() {
        // Pause auto-refresh timer when Roster modal is shown and resume when hidden
        $('#guardRosterModal').on('show.bs.modal', function () {
            if (window.isPaused !== undefined) {
                window.isPaused = true;
            }
        });

        $('#guardRosterModal').on('hidden.bs.modal', function () {
            if (window.isPaused !== undefined) {
                window.isPaused = false;
            }
        });

        // Site Switcher logic for Guard Roster Popup
        $('#grModalClientType').off('change').on('change', function() {
            var typeId = $(this).val();
            var siteDd = $('#grModalClientSite');
            siteDd.empty().append('<option value="">Client Site</option>');
            if (typeId) {
                $.ajax({
                    url: '/RoosterHub?handler=ClientSitesWithIds',
                    type: 'GET',
                    data: { type: typeId },
                    success: function(res) {
                        $.each(res, function(i, item) {
                            siteDd.append('<option value="'+item.value+'">'+item.text+'</option>');
                        });
                    }
                });
            }
        });

        $('#grModalClientSite').off('change').on('change', function() {
            var newSiteId = $(this).val();
            if (newSiteId) {
                currentGuardSiteId = newSiteId;
                loadGuardRoster();
                if (isAdminRoster) loadAdminRosterStatus();
            }
        });

        $('#btnToggleRosterEditMode').on('click', function() {
            isEditMode = !isEditMode;
            $(this).toggleClass('btn-outline-dark btn-primary');
            $(this).find('i').toggleClass('fa-pencil-square-o fa-check');
            $(this).html(isEditMode ? '<i class="fa fa-check mr-1"></i> Exit' : '<i class="fa fa-pencil-square-o mr-1"></i> RO');
            loadGuardRoster();
        });

        // Drag and Drop Event Listeners for Guard Roster
        $(document).on('dragstart', '.guard-shift-card', function (e) {
            var card = $(this);
            if (!isEditMode) { e.preventDefault(); return; }
            card.addClass('dragging');
            
            var shiftData = {
                guardId: card.data('guard-id'),
                providerName: card.data('provider-name'),
                payRateId: card.data('payrate-id'),
                callsignId: card.data('callsign-id'),
                startTime: card.data('shift-start'),
                endTime: card.data('shift-end'),
                groupId: card.data('group-id'),
                buyRate: card.data('buy-rate'),
                type: card.data('type')
            };
            e.originalEvent.dataTransfer.setData('application/json', JSON.stringify(shiftData));
            e.originalEvent.dataTransfer.effectAllowed = 'copy';
        });

        $(document).on('dragend', '.guard-shift-card', function (e) {
            $(this).removeClass('dragging');
            $('.guard-roster-cell').removeClass('drag-over');
        });

        $(document).on('dragover', '.guard-roster-cell', function (e) {
            if (isEditMode && $(this).data('site-id')) {
                e.preventDefault();
                e.originalEvent.dataTransfer.dropEffect = 'copy';
                $(this).addClass('drag-over');
            }
        });

        $(document).on('dragleave', '.guard-roster-cell', function (e) {
            $(this).removeClass('drag-over');
        });

        $(document).on('drop', '.guard-roster-cell', function (e) {
            e.preventDefault();
            $(this).removeClass('drag-over');
            if (!isEditMode) return;

            var siteId = $(this).data('site-id');
            var cellDate = $(this).data('date');
            if (!siteId || !cellDate) return;
            
            var dataStr = e.originalEvent.dataTransfer.getData('application/json');
            if (!dataStr) return;
            
            var shiftData = JSON.parse(dataStr);
            var startDateTime = cellDate + 'T' + shiftData.startTime;
            var endDateTime = cellDate + 'T' + shiftData.endTime;

            if (shiftData.endTime < shiftData.startTime) {
                var startD = new Date(cellDate + 'T00:00:00');
                var endD = new Date(startD);
                endD.setDate(endD.getDate() + 1);
                var endStr = endD.getFullYear() + '-' + String(endD.getMonth() + 1).padStart(2, '0') + '-' + String(endD.getDate()).padStart(2, '0');
                endDateTime = endStr + 'T' + shiftData.endTime;
            }

            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '/roster/Booking?handler=AddShift',
                type: 'POST',
                headers: { "RequestVerificationToken": token },
                data: {
                    groupId: $(this).data('group-id') || shiftData.groupId,
                    siteId: siteId,
                    start: startDateTime,
                    end: endDateTime,
                    guardId: shiftData.guardId,
                    providerName: shiftData.providerName,
                    payRateId: shiftData.payRateId,
                    payRate: shiftData.buyRate,
                    callsignId: shiftData.callsignId,
                    shiftType: shiftData.type || 'Regular',
                    shiftId: null
                },
                success: function (res) {
                    if (res.success) {
                        loadGuardRoster();
                    } else {
                        alert(res.message);
                    }
                }
            });
        });

        // Click Event for "+" Add Shift in Guard Roster Cell
        $(document).on('click', '.btn-add-guard-roster', function (e) {
            e.preventDefault();
            var date = $(this).data('date');
            var siteId = $(this).data('site-id');
            var groupId = $(this).data('group-id');
            openNewShiftModalForSite(date, siteId, groupId);
        });

        $('#btnPrevWeekGuard').on('click', function() {
            var parts = guardRosterStartDate.split('-');
            var d = new Date(parts[0], parts[1] - 1, parts[2]);
            d.setDate(d.getDate() - 7);
            guardRosterStartDate = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
            loadGuardRoster();
            if (isAdminRoster) loadAdminRosterStatus();
        });

        $('#btnNextWeekGuard').on('click', function() {
            var parts = guardRosterStartDate.split('-');
            var d = new Date(parts[0], parts[1] - 1, parts[2]);
            d.setDate(d.getDate() + 7);
            guardRosterStartDate = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
            loadGuardRoster();
            if (isAdminRoster) loadAdminRosterStatus();
        });

        // --- Initialize Guard Modal Select2s (Copied from Booking) ---
        function formatGuardShiftType(state) {
            if (!state.id) return state.text;
            var color = $(state.element).data('color');
            if (!color) return state.text;
            var $state = $(
                '<span><span class="type-dot" style="background-color:' + color + ';"></span>' + state.text + '</span>'
            );
            return $state;
        };

        $('#geModalShiftType').select2({
            theme: 'bootstrap4',
            minimumResultsForSearch: -1, // Hide search box
            dropdownParent: $('#guardAddShiftModal'),
            templateResult: formatGuardShiftType,
            templateSelection: formatGuardShiftType
        });

        $('#geModalGuardId').select2({
            placeholder: 'Select Guard',
            theme: 'bootstrap4',
            allowClear: true,
            dropdownParent: $('#guardAddShiftModal'),
            ajax: {
                url: '/roster/Booking?handler=SearchGuards',
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return {
                        search: params.term,
                        siteId: $('#geModalSiteId').val()
                    };
                },
                processResults: function (data) { return { results: data.results }; },
                cache: true
            },
            minimumInputLength: 0
        }).on('select2:select', function (e) {
            var data = e.params.data;
            var pId = data.providerId || data.provider;
            if (pId && data.provider && data.provider !== 'N/A') {
                if ($('#geModalProviderId').find("option[value='" + pId + "']").length) {
                    $('#geModalProviderId').val(pId).trigger('change');
                } else {
                    var newOption = new Option(data.provider, pId, true, true);
                    $('#geModalProviderId').append(newOption).trigger('change');
                }
            }
        });

        $('#geModalProviderId').select2({
            placeholder: 'Select Provider',
            theme: 'bootstrap4',
            allowClear: true,
            dropdownParent: $('#guardAddShiftModal'),
            ajax: {
                url: '/roster/Booking?handler=SearchProviders',
                dataType: 'json',
                delay: 250,
                data: function (params) { return { search: params.term, siteId: $('#geModalSiteId').val() }; },
                processResults: function (data) { return { results: data.results }; },
                cache: true
            },
            minimumInputLength: 0
        });

        $('#geModalReliefGuardId').select2({
            placeholder: 'Select Relief Guard',
            theme: 'bootstrap4',
            allowClear: true,
            dropdownParent: $('#guardAddShiftModal'),
            ajax: {
                url: '/roster/Booking?handler=SearchGuards',
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return {
                        search: params.term,
                        siteId: $('#geModalSiteId').val()
                    };
                },
                processResults: function (data) { return { results: data.results }; },
                cache: true
            },
            minimumInputLength: 0
        });

        $('#geModalReliefProviderId').select2({
            placeholder: 'Select Relief Provider',
            theme: 'bootstrap4',
            allowClear: true,
            dropdownParent: $('#guardAddShiftModal'),
            ajax: {
                url: '/roster/Booking?handler=SearchProviders',
                dataType: 'json',
                delay: 250,
                data: function (params) { return { search: params.term, siteId: $('#geModalSiteId').val() }; },
                processResults: function (data) { return { results: data.results }; },
                cache: true
            },
            minimumInputLength: 0
        });

        $('#geModalPayRateGroupId').select2({
            placeholder: 'Select Payment Profile',
            theme: 'bootstrap4',
            allowClear: true,
            dropdownParent: $('#guardAddShiftModal'),
            ajax: {
                url: '/roster/Booking?handler=SearchPayRateGroups',
                dataType: 'json',
                delay: 250,
                data: function (params) { 
                    return { 
                        search: params.term,
                        siteId: $('#geModalSiteId').val()
                    }; 
                },
                processResults: function (data) { return { results: data.results }; },
                cache: true
            },
            minimumInputLength: 0
        });

        $('#geModalPositionId').select2({
            placeholder: 'Select Rate Profile',
            theme: 'bootstrap4',
            allowClear: true,
            dropdownParent: $('#guardAddShiftModal'),
            ajax: {
                url: '/roster/Booking?handler=SearchPayRates',
                dataType: 'json',
                delay: 250,
                data: function (params) { 
                    return { 
                        search: params.term,
                        groupId: $('#geModalPayRateGroupId').val()
                    }; 
                },
                processResults: function (data) { return { results: data.results }; },
                cache: true
            },
            minimumInputLength: 0
        }).on('select2:select', function (e) {
            var data = e.params.data;
            if (data && data.guardPayRate !== undefined) {
                $('#geModalPayRate').val(data.guardPayRate);
            }
        });

        $('#geModalCallsignId').select2({
            placeholder: 'Select Position',
            theme: 'bootstrap4',
            allowClear: true,
            dropdownParent: $('#guardAddShiftModal'),
            ajax: {
                url: '/roster/Booking?handler=SearchCallsigns', // I should check if this handler exists
                dataType: 'json',
                delay: 250,
                data: function (params) { return { search: params.term, siteId: $('#geModalSiteId').val() }; },
                processResults: function (data) { return { results: data.results }; },
                cache: true
            }
        });

        $('#btnSaveGuardEditShift').on('click', function() {
            saveGuardRosterShift();
        });

        $('#btnDownloadGuardPdf').on('click', function() {
            $('#guardDownloadFilterModal').modal('show');
        });

        $('#btnConfirmGuardDownload').on('click', function() {
            var weeks = $('#guardPdfWeeks').val();
            var status = currentRosterStatus; // Send the status regardless of role
            var url = '/roster/GuardRosterAction?handler=DownloadSiteRosterPdf' + 
                '&siteId=' + currentGuardSiteId + 
                '&startDate=' + guardRosterStartDate + 
                '&weeks=' + weeks + 
                '&includeFinancials=' + isAdminFinancialsOn + 
                '&rateType=' + adminRateType + 
                '&status=' + status +
                '&includeSuppliers=' + isAdminSupplierOn;
            window.open(url, '_blank');
            $('#guardDownloadFilterModal').modal('hide');
        });

        // Admin Toggles
        $('#adminFinancialToggle').on('change', function() {
            isAdminFinancialsOn = $(this).is(':checked');
            $('#adminRateTypeSwitch').prop('disabled', !isAdminFinancialsOn);
            if (!isAdminFinancialsOn) {
                $('#adminRateTypeSwitch').prop('checked', false);
                adminRateType = 'guard';
            }
            checkRemunerationVisibility();
            loadGuardRoster();
        });

        $('#adminRateTypeSwitch').on('change', function() {
            adminRateType = $(this).is(':checked') ? 'sell' : 'guard';
            checkRemunerationVisibility();
            loadGuardRoster();
        });

        // New Truck Toggle logic
        $('#adminTruckToggle').on('change', function() {
            isAdminSupplierOn = $(this).is(':checked');
            checkRemunerationVisibility();
            loadGuardRoster();
        });

        $('#adminRosterStatus').on('change', function() {
            saveAdminRosterStatus($(this).val());
        });

        $('#adminGuardFilter').on('change', function() {
            applyGuardFilter();
        });

        // Cancellation Reason Logic
        $('input[name="cancelReason"]').on('change', function() {
            if ($(this).val() === 'Other') {
                $('#cancelReasonOtherArea').slideDown();
            } else {
                $('#cancelReasonOtherArea').slideUp();
            }
        });

        $('#btnConfirmCancellation').on('click', function() {
            var selectedReason = $('input[name="cancelReason"]:checked').val();
            var finalReason = selectedReason;
            if (selectedReason === 'Other') {
                finalReason = $('#txtCancelReasonOther').val();
            }
            
            if (!finalReason || finalReason.trim() === "") {
                alert("Please provide a reason for cancellation.");
                return;
            }

            var shiftId = $(this).data('shift-id');
            var expectedStatus = $(this).data('expected-status');
            
            $('#guardCancellationModal').modal('hide');
            executeShiftStatusUpdate(shiftId, 2, expectedStatus, finalReason);
        });
    });

    function openGuardRosterPortal(siteId, _isAdmin, guardId, _isROEditor, fromLogbook) {
        currentGuardSiteId = siteId;
        isAdminRoster = _isAdmin;
        loggedGuardId = guardId ? parseInt(guardId) : null;
        isROEditor = _isROEditor || _isAdmin; // Admins are editors by default
        isEditMode = false; // Always start with edit mode off as requested
        // Reset Edit Button
        $('#btnToggleRosterEditMode').removeClass('btn-primary').addClass('btn-outline-dark');
        $('#btnToggleRosterEditMode').html('<i class="fa fa-pencil-square-o mr-1"></i> RO');

        // Only show Edit button and Site Switcher if user has permission
        if (isROEditor) {
            $('#btnToggleRosterEditMode').removeClass('d-none');
            $('#guardRosterSiteSwitcher').removeClass('d-none').addClass('d-flex');
            
            // Reset dropdowns so they don't show stale data if the modal was previously opened for another site
            $('#grModalClientType').val('');
            $('#grModalClientSite').empty().append('<option value="">Client Site</option>');
            
            // Fetch Client Types if not loaded yet
            if ($('#grModalClientType option').length <= 1) {
                $.ajax({
                    url: '/RoosterHub?handler=ClientTypesList',
                    type: 'GET',
                    success: function(res) {
                        var dd = $('#grModalClientType');
                        dd.empty().append('<option value="">Client Type</option>');
                        $.each(res, function(i, item) {
                            dd.append('<option value="'+item.value+'">'+item.text+'</option>');
                        });
                    }
                });
            }
        } else {
            $('#btnToggleRosterEditMode').addClass('d-none');
            $('#guardRosterSiteSwitcher').removeClass('d-flex').addClass('d-none');
        }
        if (isAdminRoster) {
            $('#guardRosterAdminControls').removeClass('d-none').addClass('d-flex');
        } else {
            $('#guardRosterAdminControls').removeClass('d-flex').addClass('d-none');
            isAdminFinancialsOn = false;
            adminRateType = 'guard';
            $('#adminFinancialToggle').prop('checked', false);
            $('#adminRateTypeSwitch').prop('checked', false).prop('disabled', true);
            $('#adminTruckToggle').prop('checked', false);
            isAdminSupplierOn = false;
        }
        checkRemunerationVisibility();

        // Fetch correct start of week from server to ensure parity with Booking
        $.ajax({
            url: '/roster/GuardRosterAction?handler=GetStartOfWeek',
            type: 'GET',
            success: function(res) {
                guardRosterStartDate = res.startDate;
                $('#guardRosterModal').modal('show');
                loadGuardRoster();
                if (isAdminRoster) loadAdminRosterStatus();
            }
        });
    }

    function loadAdminRosterStatus() {
        $.ajax({
            url: '/roster/GuardRosterAction?handler=LoadRosterStatus',
            type: 'GET',
            data: { siteId: currentGuardSiteId, startDate: guardRosterStartDate },
            success: function(res) {
                $('#adminRosterStatus').val(res.status || 'Live');
                updateGridStatusDisplay(res.status || 'Live');
            }
        });
    }

    function updateGridStatusDisplay(status) {
        var container = $('.admin-status-grid-display');
        container.empty();
        
        if (status) {
            var imgName = '';
            switch(status.toUpperCase()) {
                case 'LIVE': imgName = 'STAMP - LIVE.png'; break;
                case 'PAID': imgName = 'STAMP - PAID.png'; break;
                case 'INVOICED': case 'INV': imgName = 'STAMP - INV.png'; break;
                case 'DISPUTED': imgName = 'STAMP - DISPUTED.png'; break;
                case 'CANCELLED': case 'CANCELED': case 'CANCEL': imgName = 'STAMP - CANCELD.png'; break;
            }
            if (imgName) {
                container.append('<div class="text-center">' + 
                                 '<img src="/images/stamps/' + imgName + '" class="status-stamp-img" alt="' + status + '" />' + 
                                 '</div>');
            }
        }
    }

    function checkRemunerationVisibility() {
        var showSummary = isAdminRoster && isAdminFinancialsOn && adminRateType === 'guard' && !isAdminSupplierOn;
        if (showSummary) {
            $('#remuneration-summary-section').show();
            if (lastGuardRosterData) updateRemunerationSummary();
        } else {
            $('#remuneration-summary-section').hide();
        }
    }

    function updateRemunerationSummary() {
        if (!lastGuardRosterData || !lastGuardRosterData.results) return;

        var entities = {}; // Key: guardId ?? ("P_" + providerName)
        var weekStart = guardRosterStartDate;
        var weekEnd = new Date(weekStart);
        weekEnd.setDate(weekEnd.getDate() + 6);
        $('#remuneration-week-label').text('Week: ' + formatGuardDate(new Date(weekStart)) + ' - ' + formatGuardDate(weekEnd));

        // Aggregate Pay per Entity
        lastGuardRosterData.results.forEach(function(row) {
            row.days.forEach(function(dayShifts) {
                dayShifts.forEach(function(s) {
                    var guardId = s.reliefGuardId || s.guardId;
                    var guardName = s.reliefGuardName || s.guardName;
                    
                    var key = guardId ? ("G" + guardId) : ("P" + guardName);
                    
                    if (!guardName) return;

                    if (!entities[key]) {
                        entities[key] = { id: guardId, name: guardName, provider: !guardId ? guardName : null, total: 0 };
                    }
                    
                    var duration = parseFloat(s.durationHours) || 0;
                    var payRate = s.buyRate || 0;
                    entities[key].total += (payRate * duration);
                });
            });
        });

        var entityKeys = Object.keys(entities);
        if (entityKeys.length === 0) {
            $('#remuneration-summary-body').html('<tr><td colspan="4" class="text-center text-muted p-3 small">No guards to summarize.</td></tr>');
            return;
        }

        // Fetch Database Status (Paid/Notes)
        var guardIdsStr = entityKeys.filter(k => k.startsWith('G')).map(k => k.substring(1)).join(',');
        
        $.ajax({
            url: '/roster/GuardRosterAction?handler=LoadRemunerationSummary',
            type: 'GET',
            data: { startDate: weekStart, guardIds: guardIdsStr, siteId: currentGuardSiteId },
            success: function(res) {
                if (!res.success) return;
                
                var tbody = $('#remuneration-summary-body');
                tbody.empty();

                var sortedKeys = entityKeys.sort(function(a, b) {
                    return entities[a].name.localeCompare(entities[b].name);
                });

                var grandTotal = 0;

                sortedKeys.forEach(function(key) {
                    var ent = entities[key];
                    grandTotal += ent.total;

                    var dbItem = res.results.find(function(x) { 
                        if (ent.id) return x.guardId == ent.id;
                        return x.providerName == ent.provider;
                    }) || { isPaid: false, notes: '' };
                    
                    var rowHtml = '<tr>' +
                        '<td class="px-3 font-weight-bold">' + ent.name + '</td>' +
                        '<td class="text-right remuneration-total">$' + ent.total.toFixed(2) + '</td>' +
                        '<td class="text-center">' +
                            '<input type="checkbox" class="paid-checkbox" data-guardid="' + (ent.id || '') + '" data-providername="' + (ent.provider || '') + '" data-total="' + ent.total + '" ' + (dbItem.isPaid ? 'checked' : '') + ' />' +
                        '</td>' +
                        '<td>' +
                            '<input type="text" class="remuneration-note-input" data-guardid="' + (ent.id || '') + '" data-providername="' + (ent.provider || '') + '" data-total="' + ent.total + '" value="' + (dbItem.notes || '') + '" placeholder="Add notes..." />' +
                        '</td>' +
                    '</tr>';
                    tbody.append(rowHtml);
                });

                // Add Summary Total Row
                tbody.append('<tr class="bg-light font-weight-bold">' +
                    '<td class="px-3 text-uppercase text-muted small">Summary Total</td>' +
                    '<td class="text-right" style="color: #ff3d00; border-top: 2px solid #dee2e6;">$' + grandTotal.toFixed(2) + '</td>' +
                    '<td colspan="2"></td>' +
                    '</tr>');

                $('.paid-checkbox').on('change', function() { saveRemunerationItem($(this)); });
                $('.remuneration-note-input').on('blur', function() { saveRemunerationItem($(this)); }).on('keypress', function(e) { if (e.which === 13) $(this).blur(); });
            }
        });
    }

    function saveRemunerationItem(input) {
        var guardId = input.data('guardid');
        var providerName = input.data('providername');
        var totalAmount = input.data('total');
        var row = input.closest('tr');
        var isPaid = row.find('.paid-checkbox').is(':checked');
        var notes = row.find('.remuneration-note-input').val();

        $.ajax({
            url: '/roster/GuardRosterAction?handler=SaveRemunerationSummary',
            type: 'POST',
            container: '#guardRosterModal',
            headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
            data: {
                startDate: guardRosterStartDate,
                guardId: guardId || null,
                providerName: providerName || "",
                isPaid: isPaid,
                notes: notes,
                totalAmount: totalAmount,
                siteId: currentGuardSiteId
            },
            success: function(res) {
                if (!res.success) console.error('Error saving remuneration:', res.message);
            }
        });
    }

    function saveAdminRosterStatus(newStatus) {
         $.ajax({
            url: '/roster/GuardRosterAction?handler=SaveRosterStatus',
            type: 'POST',
            container: '#guardRosterModal',
            headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
            data: { siteId: currentGuardSiteId, startDate: guardRosterStartDate, status: newStatus },
            success: function(res) {
                currentRosterStatus = newStatus;
                updateGridStatusDisplay(newStatus);
                
                // Show Success Message
                $('#spanUpdatedStatusName').text(newStatus.toUpperCase());
                $('#rosterAdminAlert').removeClass('d-none').hide().fadeIn();
                setTimeout(function() {
                    $('#rosterAdminAlert').fadeOut();
                }, 3000);
            }
        });
    }

    function applyGuardFilter() {
        var selectedVal = $('#adminGuardFilter').val(); // "G123" or "PProviderName"
        loadGuardRoster(); // Re-render everything to update totals
    }

    function loadGuardRoster() {
        if (!currentGuardSiteId || !guardRosterStartDate) return;

        var parts = guardRosterStartDate.split('-');
        var end = new Date(parts[0], parts[1] - 1, parts[2]);
        end.setDate(end.getDate() + 6);
        $('#guardWeekRangeText').html(formatGuardDate(new Date(parts[0], parts[1] - 1, parts[2])) + ' - ' + formatGuardDate(end));

        var tbody = $('#guard_roster_body');
        var thead = $('#guard_roster_header tr');
        var tfoot = $('#guard_roster_footer');
        
        tbody.html('<tr><td colspan="8" class="text-center py-5"><i class="fa fa-spinner fa-spin fa-3x text-primary opacity-25"></i><p class="mt-3 text-muted font-weight-bold">LOADING ROSTER...</p></td></tr>');
        tfoot.hide();

        $.ajax({
            url: '/roster/GuardRosterAction?handler=LoadRosterForSite',
            type: 'GET',
            data: { siteId: currentGuardSiteId, startDate: guardRosterStartDate, isEditMode: isEditMode },
            success: function (res) {
                tbody.empty();
                thead.find('th:not(:first-child)').remove();
                tfoot.find('td:not(:first-child)').remove();

                if (!res.results || res.results.length === 0) {
                    $('#guardRosterEmpty').removeClass('d-none');
                    $('#guard_roster_grid').addClass('d-none');
                    return;
                }
                $('#guardRosterEmpty').addClass('d-none');
                $('#guard_roster_grid').removeClass('d-none');
                tfoot.show();

                // Inject Day Headers (Arranged like Booking)
                var p = guardRosterStartDate.split('-');
                var d = new Date(p[0], p[1] - 1, p[2]);
                for (var i = 0; i < 7; i++) {
                    var dayDate = new Date(d);
                    dayDate.setDate(d.getDate() + i);
                    
                    var ph = isPublicHolidayAtDate(dayDate.getTime(), res.holidays, res.siteState);
                    var phIcon = ph ? phIconSvg : "";
                    var phTitle = ph ? ph.reason : "";
                    
                    var dateStr = dayDate.toLocaleDateString('en-GB', { weekday: 'short', day: '2-digit', month: 'short' }).toUpperCase();
                    thead.append('<th style="width: 12.14%;" title="' + phTitle + '"><div>' + dateStr + phIcon + '</div></th>');
                    tfoot.children('tr').append('<td class="p-0"><div class="total-item"><span class="total-label">Daily Total</span><span class="total-value font-weight-bold" id="daily_total_' + i + '">0h</span></div></td>');
                }

                 lastGuardRosterData = res;
                 currentRosterGroupId = res.rosterGroupId || null;

                // Update Filter Dropdown (Add unique guards found in data)
                var filterSelect = $('#adminGuardFilter');
                var currentSelection = filterSelect.val();
                filterSelect.find('option:not([value="ALL"])').remove();
                
                var filterGuards = [];
                res.results.forEach(function(row) {
                    row.days.forEach(function(dayShifts) {
                        dayShifts.forEach(function(s) {
                            var gId = s.reliefGuardId || s.guardId;
                            var gName = s.reliefGuardName || s.guardName;
                            var k = gId ? ("G" + gId) : ("P" + gName);
                            if (gName && !filterGuards.find(x => x.key === k)) {
                                filterGuards.push({ key: k, name: gName });
                            }
                        });
                    });
                });
                
                filterGuards.sort((a,b) => a.name.localeCompare(b.name)).forEach(g => {
                    filterSelect.append('<option value="' + g.key + '">' + g.name + '</option>');
                });
                filterSelect.val(currentSelection || "ALL");
                    var filterVal = filterSelect.val();
                var grandTotalHours = 0;
                var grandTotalCost = 0;
                var dailyTotalHours = [0,0,0,0,0,0,0];
                var dailyTotalCost = [0,0,0,0,0,0,0];

                var absenceDict = {};
                res.results.forEach(function (r) {
                    r.days.forEach(function (ds, dayIndex) {
                        var ps = guardRosterStartDate.split('-');
                        var loopDate = new Date(ps[0], ps[1]-1, ps[2]);
                        loopDate.setDate(loopDate.getDate() + dayIndex);
                        var dateStr = String(loopDate.getDate()).padStart(2, '0') + '/' + String(loopDate.getMonth()+1).padStart(2, '0');
                        
                        ds.forEach(function (s) {
                            if (s.reliefReason) {
                                var key = (s.guardName || "Unassigned") + " - " + s.reliefReason;
                                if (s.reliefReasonOther) key += " (" + s.reliefReasonOther + ")";
                                
                                if (!absenceDict[key]) absenceDict[key] = [];
                                if (absenceDict[key].indexOf(dateStr) === -1) absenceDict[key].push(dateStr);
                            }
                            if (s.status === 2) {
                                var key = (s.guardName || "Unassigned") + " - Declined";
                                
                                if (!absenceDict[key]) absenceDict[key] = [];
                                if (absenceDict[key].indexOf(dateStr) === -1) absenceDict[key].push(dateStr);
                            }
                        });
                    });
                });
                var globalAbsences = Object.keys(absenceDict).map(function(key) {
                    return "- " + key + " (" + absenceDict[key].join(', ') + ")";
                });

                var legendHtml = '<div class="mt-3 pt-2 border-top" style="font-size: 9px; line-height: 1.2; text-shadow: none;">' +
                    '<div class="d-flex align-items-center mb-1"><span style="color: #9E9E9E; margin-right: 4px; font-size: 10px;">●</span> Unassigned - UNKNOWN</div>' +
                    '<div class="d-flex align-items-center mb-1"><span style="color: #FFA726; margin-right: 4px; font-size: 10px;">●</span> Unassigned - FIXED</div>' +
                    '<div class="d-flex align-items-center mb-1"><span style="color: #E65100; margin-right: 4px; font-size: 10px;">●</span> Unassigned - ADHOC</div>' +
                    '<div class="d-flex align-items-center mb-1"><span style="color: #66BB6A; margin-right: 4px; font-size: 10px;">●</span> Accepted - FIXED</div>' +
                    '<div class="d-flex align-items-center mb-1"><span style="color: #1B5E20; margin-right: 4px; font-size: 10px;">●</span> Accepted - ADHOC</div>' +
                    '<div class="d-flex align-items-center mb-1"><span style="color: #8e24aa; margin-right: 4px; font-size: 10px;">●</span> Relief Guard (Accepted)</div>' +
                    '<div class="d-flex align-items-center mb-1"><span style="color: #000; margin-right: 4px; font-size: 10px;">●</span> DECLINED (OPEN)</div>' +
                    '<div class="d-flex align-items-center mb-2"><span style="color: #e53935; margin-right: 4px; font-size: 10px;">● <i class="fa fa-times" style="font-size: 8px;"></i></span> CANCELLED (CLOSED)</div>' +
                    '<div class="font-weight-bold mt-2 mb-1" style="color: #000;">Not Avalible (DNC):</div>' +
                    '<div style="color: #000;">';
                
                if (globalAbsences.length > 0) {
                    globalAbsences.forEach(function(note) {
                        legendHtml += '<div class="mb-1" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="' + note + '">' + note + '</div>';
                    });
                } else {
                    legendHtml += '<div class="text-muted font-italic">None</div>';
                }
                legendHtml += '</div></div>';

                res.results.forEach(function (row) {
                    var projectWeeklyHours = 0;
                    var projectWeeklyCost = 0;
                    var projectDailyHours = [0,0,0,0,0,0,0];
                    var projectDailyCost = [0,0,0,0,0,0,0];

                    if (isEditMode) {
                        var headerRowHtml = '<tr class="bg-light">' +
                            '<td colspan="8" class="py-2 px-3 font-weight-bold text-dark text-left" style="font-size: 12.5px; border-bottom: 1px solid #dee2e6;">' +
                                '📁 Project: ' + row.projectName +
                            '</td>' +
                        '</tr>';
                        tbody.append(headerRowHtml);
                    }

                    var statusStampHtml = '';
                    var status = row.projectStatus || res.status;
                    if (isEditMode && status) {
                        var imgName = '';
                        switch(status.toUpperCase()) {
                            case 'LIVE': imgName = 'STAMP - LIVE.png'; break;
                            case 'PAID': imgName = 'STAMP - PAID.png'; break;
                            case 'INVOICED': case 'INV': imgName = 'STAMP - INV.png'; break;
                            case 'DISPUTED': imgName = 'STAMP - DISPUTED.png'; break;
                            case 'CANCELLED': case 'CANCELED': case 'CANCEL': imgName = 'STAMP - CANCELD.png'; break;
                        }
                        if (imgName) {
                            statusStampHtml = '<div class="text-center">' + 
                                             '<img src="/images/stamps/' + imgName + '" class="status-stamp-img" alt="' + status + '" />' + 
                                             '</div>';
                        }
                    }

                    var rowHtml = '<tr>' +
                        '<td class="align-top px-3 text-left d-flex flex-column" style="min-height: 150px;">' + 
                            '<div>' + 
                                '<div class="guard-site-name">' + row.siteName + '</div>' + 
                                '<div class="guard-client-type">' + row.clientTypeName + '</div>' + 
                            '</div>' + 
                            '<div class="admin-status-grid-display mt-auto pb-2">' + statusStampHtml + '</div>' + 
                            legendHtml +
                        '</td>';

                    row.days.forEach(function (dayShifts, index) {
                        var ps = guardRosterStartDate.split('-');
                        var loopDate = new Date(ps[0], ps[1]-1, ps[2]);
                        loopDate.setDate(loopDate.getDate() + index);
                        
                        var ph = isPublicHolidayAtDate(loopDate.getTime(), res.holidays, res.siteState);
                        var phClass = ph ? "guard-ph-highlight" : "";
                        var phReason = ph ? ph.reason : "";
                        
                        var weekendClass = "";
                        if (loopDate.getDay() === 6) weekendClass = "guard-sat-highlight";
                        else if (loopDate.getDay() === 0) weekendClass = "guard-sun-highlight";
                        
                        var dStr = loopDate.getFullYear() + '-' + String(loopDate.getMonth() + 1).padStart(2, '0') + '-' + String(loopDate.getDate()).padStart(2, '0');
                        rowHtml += '<td class="guard-roster-cell ' + phClass + ' ' + weekendClass + '" data-date="' + dStr + '" data-site-id="' + row.siteId + '" data-group-id="' + (row.rosterGroupId || '') + '" title="' + phReason + '">';
                        
                        dayShifts.forEach(function (s) {
                            var guardId = s.reliefGuardId || s.guardId;
                            var guardName = s.reliefGuardName || s.reliefProviderName || s.guardName;
                            var key = guardId ? ("G" + guardId) : ("P" + guardName);
                            
                            // Apply Filtering
                            if (filterVal !== "ALL" && filterVal !== key) return;

                            var duration = parseFloat(s.durationHours);
                            var activeRate = (adminRateType == 'sell' ? s.sellRate : s.buyRate);
                            var cost = duration * activeRate;

                            dailyTotalHours[index] += duration;
                            grandTotalHours += duration;
                            dailyTotalCost[index] += cost;
                            grandTotalCost += cost;

                            projectDailyHours[index] += duration;
                            projectWeeklyHours += duration;
                            projectDailyCost[index] += cost;
                            projectWeeklyCost += cost;

                            var statusClass = 'status-pushed';
                            if (s.status === 1) statusClass = 'status-accepted';
                            if (s.status === 2) statusClass = 'status-declined';
                            if (s.status === 3) statusClass = 'status-cancelled';

                            var typeClass = 'type-regular';
                            if (s.shiftType === 'Adhoc') typeClass = 'type-adhoc';
                            if (s.providerName && (!s.guardId || s.guardName === 'External')) typeClass += ' type-provider';

                             var isRelief = s.reliefGuardId || s.reliefProviderName;
                            // Ownership logic: If a relief guard is assigned, they are the ONLY owner. 
                            // Otherwise, the main guard is the owner.
                            var belongsToLoggedGuard = loggedGuardId && (
                                s.reliefGuardId ? (s.reliefGuardId === loggedGuardId) : (s.guardId === loggedGuardId)
                            );
                            
                            // Check if date is today or future
                            var shiftDate = new Date(s.shiftDate || loopDate);
                            var today = new Date();
                            today.setHours(0,0,0,0);
                            var isFutureOrToday = shiftDate >= today;

                            rowHtml += '<div class="guard-shift-card clickable-shift ' + (isRelief ? 'shift-relief ' : '') + statusClass + ' ' + typeClass + '" draggable="' + isEditMode + '" ' +
                                'data-shift-id="' + s.id + '" data-status="' + s.status + '" data-type="' + s.shiftType + '" data-guard-id="' + s.guardId + '" data-relief-guard-id="' + (s.reliefGuardId || '') + '" data-is-future="' + isFutureOrToday + '" ' +
                                'data-guard-name="' + (s.guardName || '') + '" data-shift-start="' + s.shiftStart + '" data-shift-end="' + s.shiftEnd + '" ' +
                                'data-provider-name="' + (s.providerName || '') + '" data-relief-provider-name="' + (s.reliefProviderName || '') + '" ' +
                                'data-relief-reason="' + (s.reliefReason || '') + '" data-relief-reason-other="' + (s.reliefReasonOther || '') + '" ' +
                                'data-adhoc-text="' + (s.adhocOffsiteText || '') + '" data-callsign-id="' + (s.callsignId || '') + '" data-callsign-name="' + (s.callsignName || '') + '" ' +
                                'data-payrate-id="' + (s.payRateId || '') + '" data-payrate-group-id="' + (s.payRateGroupId || '') + '" ' +
                                'data-buy-rate="' + s.buyRate + '" data-group-id="' + s.groupId + '">' +
                                (isEditMode ? '<span class="btn-delete-shift" onclick="deleteGuardRosterShift(event, ' + s.id + ')"><i class="fa fa-times"></i></span>' : '') +
                                (isEditMode ? '<span class="btn-edit-shift" onclick="openEditShiftModal(' + s.id + ', ' + s.groupId + ', ' + row.siteId + ')"><i class="fa fa-pencil"></i></span>' : '') +
                                (belongsToLoggedGuard && !isEditMode ? '<i class="fa fa-pencil guard-edit-icon" title="Your Shift"></i>' : '') +
