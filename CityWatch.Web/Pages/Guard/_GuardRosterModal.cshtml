        letter-spacing: 0.5px;
        padding: 12px 8px;
        border: none !important;
    }
    .status-stamp-img {
        max-width: 100px;
        height: auto;
        display: block;
        margin: 5px auto 0;
    }

    #guard_roster_grid tbody td {
        padding: 10px 8px !important;
