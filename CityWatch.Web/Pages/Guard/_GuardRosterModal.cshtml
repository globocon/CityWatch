@using CityWatch.Web.Helpers
@using CityWatch.Data.Helpers

<style>
    #roster-modal-content .table th {
        background-color: #6f42c1;
        color: white;
        text-align: center;
        font-size: 0.85rem;
        padding: 8px 4px;
    }

    #roster-modal-content .table td {
        vertical-align: top;
        padding: 4px;
        min-width: 120px;
        border: 1px solid #dee2e6;
    }

    .roster-shift-card {
        font-size: 0.75rem;
        margin-bottom: 4px;
        padding: 4px;
        border-radius: 4px;
        border-left: 3px solid;
    }

    .roster-shift-regular {
        background-color: #fff3e0;
        border-left-color: #ff9800;
    }

    .roster-shift-relief {
        background-color: #f3e5f5;
        border-left-color: #6f42c1;
        color: #4a148c;
    }

    .ph-highlight {
        background-color: #fff9c4 !important;
    }

    .weekend-highlight {
        background-color: #f8f9fa;
    }
</style>

<!-- PIN Authentication Modal -->
<div class="modal fade" id="rosterPinModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title"><i class="fa fa-lock mr-2"></i>Security Verification</h6>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group mb-2">
                    <label>Enter your PIN</label>
                    <input type="password" id="rosterPinInput" class="form-control" maxlength="6" autocomplete="off" />
                </div>
                <div id="rosterPinError" class="text-danger small mb-2" style="display:none;"></div>
                <div class="d-flex justify-content-between align-items-center">
                    <a href="#" id="btnRosterForgotPin" class="small text-primary">Forgot PIN?</a>
                    <button type="button" class="btn btn-primary btn-sm" id="btnVerifyRosterPin">
                        <i class="fa fa-sign-in mr-1"></i>Verify
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Roster Modal -->
<div class="modal fade" id="siteRosterModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title"><i class="fa fa-calendar-o mr-2"></i>Site Roster: <span id="rosterModalSiteName">Loading...</span></h5>
                </div>
                <div class="d-flex align-items-center">
                    <div class="mr-3">
                        <select id="rosterWeekSelect" class="form-control form-control-sm">
                            <!-- Populated via JS -->
                        </select>
                    </div>
                    <button type="button" class="btn btn-primary btn-sm mr-3" id="btnDownloadRosterPdf">
                        <i class="fa fa-download mr-1"></i>Download PDF
                    </button>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </div>
            <div class="modal-body p-0" id="roster-modal-content">
                <div class="table-responsive">
                    <table class="table table-bordered mb-0">
                        <thead id="rosterHeader">
                            <!-- Populated via JS -->
                        </thead>
                        <tbody id="rosterBody">
                            <!-- Populated via JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (function($) {
        var currentSiteId = 0;
        var selectedStartDate = null;

        $(document).on('click', '#btnRosterDetails', function() {
            currentSiteId = $('#ClientSiteID').val();
            $('#rosterPinInput').val('');
            $('#rosterPinError').hide();
            $('#rosterPinModal').modal('show');
        });

        $('#btnVerifyRosterPin').on('click', function() {
            verifyPin();
        });

        $('#rosterPinInput').on('keypress', function(e) {
            if (e.which == 13) verifyPin();
        });

        function verifyPin() {
            var pin = $('#rosterPinInput').val();
            var guardId = $('#GuardLog_GuardLogin_GuardId').val();

            if (!pin) {
                $('#rosterPinError').text('Please enter your PIN.').show();
                return;
            }

            $.ajax({
                url: '/Admin/GuardSettings?handler=GuardHrDocLoginConformation',
                type: 'POST',
                data: { guardId: guardId, key: pin },
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() }
            }).done(function(result) {
                if (result.accessPermission) {
                    $('#rosterPinModal').modal('hide');
                    initRosterModal();
                } else {
                    $('#rosterPinError').text('Invalid PIN. Please try again.').show();
                }
            });
        }

        $('#btnRosterForgotPin').on('click', function(e) {
            e.preventDefault();
            $('#rosterPinModal').modal('hide');
            $('#loginHrNewPasswordSetGuard').modal('show');
        });

        function initRosterModal() {
            populateWeeks();
            loadRoster();
            $('#siteRosterModal').modal('show');
        }

        function populateWeeks() {
            var $select = $('#rosterWeekSelect');
            $select.empty();
            
            var today = new Date();
            var currentDay = today.getDay();
            var diff = today.getDate() - currentDay + (currentDay == 0 ? -6 : 1);
            var monday = new Date(today.setDate(diff));
            monday.setHours(0,0,0,0);

            for (var i = -1; i <= 4; i++) {
                var start = new Date(monday);
                start.setDate(monday.getDate() + (i * 7));
                var end = new Date(start);
                end.setDate(start.getDate() + 6);
                
                var label = (i === 0 ? "Current Week" : (i === -1 ? "Previous Week" : "Week " + i));
                var value = start.toISOString().split('T')[0];
                
                $select.append(`<option value="${value}" ${i === 0 ? 'selected' : ''}>${label} (${start.toLocaleDateString()} - ${end.toLocaleDateString()})</option>`);
            }
            selectedStartDate = $select.val();
        }

        $('#rosterWeekSelect').on('change', function() {
            selectedStartDate = $(this).val();
            loadRoster();
        });

        function loadRoster() {
            $('#rosterBody').html('<tr><td colspan="8" class="text-center p-5"><i class="fa fa-spinner fa-spin fa-2x"></i><br>Loading Roster...</td></tr>');
            
            $.get('/roster/GuardRosterAction?handler=LoadRosterForSite', {
                siteId: currentSiteId,
                startDate: selectedStartDate
            }, function(data) {
                renderRoster(data);
            });
        }

        function renderRoster(data) {
            $('#rosterModalSiteName').text(data.siteName || "Current Site");
            
            var headHtml = '<tr><th style="width:160px;">Guard Name</th>';
            var start = new Date(selectedStartDate);
            for (var i = 0; i < 7; i++) {
                var d = new Date(start);
                d.setDate(start.getDate() + i);
                headHtml += `<th>${d.toLocaleDateString('en-GB', { weekday: 'short', day: '2-digit', month: '2-digit' })}</th>`;
            }
            headHtml += '</tr>';
            $('#rosterHeader').html(headHtml);

            var bodyHtml = '';
            var guardShifts = {};
            
            // Group by guard
            data.results.forEach(function(s) {
                if (!guardShifts[s.guardName]) guardShifts[s.guardName] = {};
                var dayStr = new Date(s.startDate).toISOString().split('T')[0];
                if (!guardShifts[s.guardName][dayStr]) guardShifts[s.guardName][dayStr] = [];
                guardShifts[s.guardName][dayStr].push(s);
            });

            var guards = Object.keys(guardShifts).sort();
            if (guards.length === 0) {
                bodyHtml = '<tr><td colspan="8" class="text-center text-muted p-4">No shifts found for this week.</td></tr>';
            } else {
                guards.forEach(function(name) {
                    bodyHtml += `<tr><td class="font-weight-bold">${name}</td>`;
                    for (var i = 0; i < 7; i++) {
                        var d = new Date(start);
                        d.setDate(start.getDate() + i);
                        var dayStr = d.toISOString().split('T')[0];
                        
                        var isPH = isPublicHoliday(d, data.holidays, data.siteState);
                        var isWeekend = (d.getDay() === 0 || d.getDay() === 6);
                        var cellClass = isPH ? 'ph-highlight' : (isWeekend ? 'weekend-highlight' : '');
                        
                        bodyHtml += `<td class="${cellClass}">`;
                        if (guardShifts[name][dayStr]) {
                            guardShifts[name][dayStr].forEach(function(s) {
                                var isRelief = s.guardName.indexOf('{R}') === 0;
                                var cardClass = isRelief ? 'roster-shift-relief' : 'roster-shift-regular';
                                bodyHtml += `<div class="roster-shift-card ${cardClass}">
                                    <div class="font-weight-bold">${s.shiftStart} - ${s.shiftEnd}</div>
                                    <div class="small">${s.callsignName || ''}</div>
                                    <div style="font-size:0.65rem; opacity:0.8;">${s.licenseNo || ''}</div>
                                </div>`;
                            });
                        }
                        bodyHtml += '</td>';
                    }
                    bodyHtml += '</tr>';
                });
            }
            $('#rosterBody').html(bodyHtml);
        }

        function isPublicHoliday(date, holidays, state) {
            if (!holidays) return false;
            var dStr = date.toISOString().split('T')[0];
            var siteState = (state || "").trim().toUpperCase();
            
            for (var i = 0; i < holidays.length; i++) {
                var h = holidays[i];
                var hStart = new Date(h.startDate).toISOString().split('T')[0];
                var hEnd = new Date(h.expiryDate).toISOString().split('T')[0];
                
                if (dStr >= hStart && dStr <= hEnd) {
                    if (!h.states || h.states.length === 0 || h.states.indexOf("ALL") !== -1) return true;
                    if (h.states.indexOf(siteState) !== -1) return true;
                }
            }
            return false;
        }

        $('#btnDownloadRosterPdf').on('click', function() {
            window.open(`/roster/GuardRosterAction?handler=DownloadSiteRosterPdf&siteId=${currentSiteId}&startDate=${selectedStartDate}`, '_blank');
        });

    })(jQuery);
</script>
