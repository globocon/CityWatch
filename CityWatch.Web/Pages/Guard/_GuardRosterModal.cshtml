    function openGuardRosterPortal(siteId, _isAdmin, guardId) {
        currentGuardSiteId = siteId;
        isAdminRoster = _isAdmin === true;
        loggedGuardId = guardId ? parseInt(guardId) : null;
        
        if (isAdminRoster) {
            $('#guardRosterAdminControls').removeClass('d-none').addClass('d-flex');
