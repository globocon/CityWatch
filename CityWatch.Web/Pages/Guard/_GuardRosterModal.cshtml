    function updateGridStatusDisplay(status) {
        var container = $('.admin-status-grid-display');
        container.empty();
        
        if (status) {
            var imgName = '';
            switch(status.toUpperCase()) {
                case 'LIVE': imgName = 'STAMP - LIVE.png'; break;
                case 'PAID': imgName = 'STAMP - PAID.png'; break;
                case 'INVOICED': case 'INV': imgName = 'STAMP - INV.png'; break;
                case 'CANCELLED': case 'CANCELED': case 'CANCEL': imgName = 'STAMP - CANCELD.jpg'; break;
            }
            if (imgName) {
                container.append('<div class="text-center">' + 
                                 '<img src="/images/stamps/' + imgName + '" class="status-stamp-img" alt="' + status + '" />' + 
                                 '</div>');
            }
        }
    }

    function checkRemunerationVisibility() {
        var showSummary = isAdminRoster && isAdminFinancialsOn && adminRateType === 'guard' && !isAdminSupplierOn;
        if (showSummary) {
            $('#remuneration-summary-section').show();
            if (lastGuardRosterData) updateRemunerationSummary();
        } else {
            $('#remuneration-summary-section').hide();
        }
    }

    function updateRemunerationSummary() {
        if (!lastGuardRosterData || !lastGuardRosterData.results) return;

        var entities = {}; // Key: guardId ?? ("P_" + providerName)
        var weekStart = guardRosterStartDate;
        var weekEnd = new Date(weekStart);
        weekEnd.setDate(weekEnd.getDate() + 6);
        $('#remuneration-week-label').text('Week: ' + formatGuardDate(new Date(weekStart)) + ' - ' + formatGuardDate(weekEnd));

        // Aggregate Pay per Entity
        lastGuardRosterData.results.forEach(function(row) {
            row.days.forEach(function(dayShifts) {
                dayShifts.forEach(function(s) {
                    var guardId = s.reliefGuardId || s.guardId;
                    var guardName = s.reliefGuardName || s.guardName;
                    
                    var key = guardId ? ("G" + guardId) : ("P" + guardName);
                    
                    if (!guardName) return;

                    if (!entities[key]) {
                        entities[key] = { id: guardId, name: guardName, provider: !guardId ? guardName : null, total: 0 };
                    }
                    
                    var duration = parseFloat(s.durationHours) || 0;
                    var payRate = s.buyRate || 0;
                    entities[key].total += (payRate * duration);
                });
            });
        });

        var entityKeys = Object.keys(entities);
        if (entityKeys.length === 0) {
            $('#remuneration-summary-body').html('<tr><td colspan="4" class="text-center text-muted p-3 small">No guards to summarize.</td></tr>');
            return;
        }

        // Fetch Database Status (Paid/Notes)
        var guardIdsStr = entityKeys.filter(k => k.startsWith('G')).map(k => k.substring(1)).join(',');
        
        $.ajax({
            url: '/roster/GuardRosterAction?handler=LoadRemunerationSummary',
            type: 'GET',
            data: { startDate: weekStart, guardIds: guardIdsStr },
            success: function(res) {
                if (!res.success) return;
                
                var tbody = $('#remuneration-summary-body');
                tbody.empty();

                var sortedKeys = entityKeys.sort(function(a, b) {
                    return entities[a].name.localeCompare(entities[b].name);
                });

                var grandTotal = 0;

                sortedKeys.forEach(function(key) {
                    var ent = entities[key];
                    grandTotal += ent.total;

                    var dbItem = res.results.find(function(x) { 
                        if (ent.id) return x.guardId == ent.id;
                        return x.providerName == ent.provider;
                    }) || { isPaid: false, notes: '' };
                    
                    var rowHtml = '<tr>' +
                        '<td class="px-3 font-weight-bold">' + ent.name + '</td>' +
                        '<td class="text-right remuneration-total">$' + ent.total.toFixed(2) + '</td>' +
                        '<td class="text-center">' +
                            '<input type="checkbox" class="paid-checkbox" data-guardid="' + (ent.id || '') + '" data-providername="' + (ent.provider || '') + '" data-total="' + ent.total + '" ' + (dbItem.isPaid ? 'checked' : '') + ' />' +
                        '</td>' +
                        '<td>' +
                            '<input type="text" class="remuneration-note-input" data-guardid="' + (ent.id || '') + '" data-providername="' + (ent.provider || '') + '" data-total="' + ent.total + '" value="' + (dbItem.notes || '') + '" placeholder="Add notes..." />' +
                        '</td>' +
                    '</tr>';
                    tbody.append(rowHtml);
                });

                // Add Summary Total Row
                tbody.append('<tr class="bg-light font-weight-bold">' +
                    '<td class="px-3 text-uppercase text-muted small">Summary Total</td>' +
                    '<td class="text-right" style="color: #ff3d00; border-top: 2px solid #dee2e6;">$' + grandTotal.toFixed(2) + '</td>' +
                    '<td colspan="2"></td>' +
                    '</tr>');

                $('.paid-checkbox').on('change', function() { saveRemunerationItem($(this)); });
                $('.remuneration-note-input').on('blur', function() { saveRemunerationItem($(this)); }).on('keypress', function(e) { if (e.which === 13) $(this).blur(); });
            }
        });
    }

    function saveRemunerationItem(input) {
        var guardId = input.data('guardid');
        var providerName = input.data('providername');
        var totalAmount = input.data('total');
        var row = input.closest('tr');
        var isPaid = row.find('.paid-checkbox').is(':checked');
        var notes = row.find('.remuneration-note-input').val();

        $.ajax({
            url: '/roster/GuardRosterAction?handler=SaveRemunerationSummary',
            type: 'POST',
            container: '#guardRosterModal',
            headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
            data: {
                startDate: guardRosterStartDate,
                guardId: guardId || null,
                providerName: providerName || "",
                isPaid: isPaid,
                notes: notes,
                totalAmount: totalAmount
            },
            success: function(res) {
                if (!res.success) console.error('Error saving remuneration:', res.message);
            }
        });
    }

