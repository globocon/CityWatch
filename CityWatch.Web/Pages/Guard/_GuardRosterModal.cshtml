                                <input type="checkbox" class="custom-control-input" id="adminRateTypeSwitch" disabled>
                                <label class="custom-control-label" for="adminRateTypeSwitch"></label>
                            </div>
                            <i class="fa fa-cube" style="font-size: 1.1rem; color: #555;" title="Sell Rate to Client"></i>
                        </div>

                        <!-- Truck Toggle group -->
                        <div class="d-inline-flex align-items-center mr-4" style="vertical-align: middle;">
                            <div style="position: relative; display: inline-block; line-height: 1;" class="mr-2">
                                <i class="fa fa-truck text-dark" style="font-size: 1.1rem;"></i>
                                <span style="position: absolute; right: -4px; top: -6px; background: #0056b3; color: white; border-radius: 2px; font-size: 7px; padding: 1px 2px; font-weight: bold; border: 1px solid #fff;">S</span>
                            </div>
                            <div class="custom-control custom-switch">
                                <input type="checkbox" class="custom-control-input" id="adminTruckToggle">
                                <label class="custom-control-label" for="adminTruckToggle"></label>
                            </div>
                        </div>

                        <!-- Roster Status Control -->
                        <div class="input-group input-group-sm ml-2" style="width: 160px;">
                             <div class="input-group-prepend">
                                <span class="input-group-text bg-white border-right-0 text-muted small font-weight-bold">STATUS</span>
                            </div>
                            <select id="adminRosterStatus" class="form-control font-weight-bold text-uppercase" style="font-size: 10px; height: 32px; border-left: 0;">
                                <option value="Live">Live (Pushed)</option>
                                <option value="Accepted">Accepted (Green)</option>
                                <option value="Paid">Paid (Stamp)</option>
                                <option value="Invoiced">Invoiced (Stamp)</option>
                                <option value="Cancelled">Cancelled (Black)</option>
                            </select>
                        </div>

                        <!-- Guard Filter Control [NEW] -->
                        <div class="input-group input-group-sm ml-3" style="width: 190.14px;">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white border-right-0 text-muted small font-weight-bold"><i class="fa fa-filter mr-1"></i> FILTER</span>
                            </div>
                            <select id="adminGuardFilter" class="form-control font-weight-bold" style="font-size: 10px; height: 32px; border-left: 0;">
                                <option value="ALL">ALL GUARDS</option>
                            </select>
                        </div>
                    </div>
                </div>

                    <button type="button" class="btn btn-outline-success btn-sm px-3 shadow-sm font-weight-bold mr-3" id="btnDownloadGuardPdf">
                        <i class="fa fa-file-pdf-o mr-2"></i>Download PDF
                    </button>
                    <button type="button" class="close p-2 m-0" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true" style="font-size: 1.5rem;">&times;</span>
                    </button>
                </div>
            <div id="rosterAdminAlert" class="alert alert-success d-none py-1 px-3 m-0 rounded-0 text-center font-weight-bold" style="font-size: 0.8rem; border-bottom: 1px solid #c3e6cb;">
                <i class="fa fa-check-circle mr-2"></i>Status updated to <span id="spanUpdatedStatusName"></span> successfully!
            </div>
            <div class="modal-body p-0 bg-light" style="min-height: 500px; max-height: 80vh; overflow-y: auto;">
                <div id="guardRosterEmpty" class="d-none text-center py-5 bg-white m-3 rounded shadow-sm">
                    <div style="font-size: 64px; color: #e9ecef; margin-bottom: 20px;">
                        <i class="fa fa-calendar-times-o"></i>
                    </div>
                    <h4 class="text-secondary mb-3" style="font-weight: 300;">No Roster Found</h4>
                    <p class="text-muted mb-0">We couldn't find any scheduled shifts for this site in the selected week.</p>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-bordered mb-0" id="guard_roster_grid">
                        <thead id="guard_roster_header">
                            <tr>
                                <th style="width: 15%;" class="align-middle">Client Site</th>
                                <!-- Day headers will be injected here -->
                            </tr>
                        </thead>
                        <tbody id="guard_roster_body">
                            <!-- Rows will be injected here -->
                        </tbody>
                        <tfoot id="guard_roster_footer" style="display: none; background: #fff; border-top: 2px solid #dee2e6;">
                            <tr>
                                <td class="p-0 border-right align-middle">
                                    <div class="grand-total-container" style="background: #f8faff;">
                                        <div class="total-item">
                                            <span class="total-label">Weekly Total</span>
                                            <span class="total-value font-weight-bold text-primary" id="guard_weekly_grand_total">0h</span>
                                        </div>
                                    </div>
                                </td>
                                <!-- Daily totals will be injected here -->
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- Remuneration Summary Section -->
                <div id="remuneration-summary-section" style="display: none;">
                    <div class="remuneration-header">
                        <h6 class="mb-0 text-primary font-weight-bold">
                            <i class="fa fa-money mr-2"></i> Remuneration Summary
                        </h6>
                        <span class="badge badge-info px-3 py-1 rounded-pill" id="remuneration-week-label"></span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 remuneration-table" id="remuneration-summary-table">
                            <thead>
                                <tr>
                                    <th class="px-3">Guard Name</th>
                                    <th class="text-right" style="width: 130px;">Total Amount</th>
                                    <th class="text-center" style="width: 70px;">Paid</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody id="remuneration-summary-body">
                                <!-- Dynamic rows via JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Simple Filter Modal for PDF Download -->
<div class="modal fade" id="guardDownloadFilterModal" tabindex="-1" role="dialog" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header p-3">
                <h6 class="modal-title font-weight-bold">PDF Export Options</h6>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">&times;</button>
            </div>
            <div class="modal-body p-4">
                <label class="small font-weight-bold text-muted mb-2 d-block text-uppercase">Duration to export</label>
                <select id="guardPdfWeeks" class="form-control form-control-sm border-primary">
                    <option value="1">This Week Only</option>
                    <option value="2">2 Weeks Binder</option>
                    <option value="4">4 Weeks Binder</option>
                </select>
            </div>
            <div class="modal-footer p-2 bg-light">
                <button type="button" class="btn btn-primary btn-block font-weight-bold" id="btnConfirmGuardDownload">GENERATE REPORT</button>
            </div>
        </div>
