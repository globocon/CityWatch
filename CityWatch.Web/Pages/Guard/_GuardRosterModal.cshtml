</div>

<!-- Modal for Cancellation Reason -->
<div class="modal fade" id="guardCancellationModal" tabindex="-1" role="dialog" aria-hidden="true" style="z-index: 1100;">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-dark text-white p-3">
                <h6 class="modal-title font-weight-bold"><i class="fa fa-exclamation-triangle mr-2 text-warning"></i>Reason for Relief</h6>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">&times;</button>
            </div>
            <div class="modal-body p-4">
                <p class="small text-muted mb-3 font-weight-bold text-uppercase">Please select a reason for cancelling this shift:</p>
                
                <div class="d-flex flex-wrap mb-3">
                    <div class="custom-control custom-radio mr-3 mb-2">
                        <input type="radio" id="optSick" name="cancelReason" class="custom-control-input" value="Sick">
                        <label class="custom-control-label font-weight-bold" for="optSick">Sick</label>
                    </div>
                    <div class="custom-control custom-radio mr-3 mb-2">
                        <input type="radio" id="optAL" name="cancelReason" class="custom-control-input" value="AL">
                        <label class="custom-control-label font-weight-bold" for="optAL">AL</label>
                    </div>
                    <div class="custom-control custom-radio mr-3 mb-2">
                        <input type="radio" id="optRDO" name="cancelReason" class="custom-control-input" value="RDO">
                        <label class="custom-control-label font-weight-bold" for="optRDO">RDO</label>
                    </div>
                    <div class="custom-control custom-radio mr-3 mb-2">
                        <input type="radio" id="optLWOP" name="cancelReason" class="custom-control-input" value="LWOP">
                        <label class="custom-control-label font-weight-bold" for="optLWOP">LWOP</label>
                    </div>
                    <div class="custom-control custom-radio mb-2">
                        <input type="radio" id="optOther" name="cancelReason" class="custom-control-input" value="Other">
                        <label class="custom-control-label font-weight-bold" for="optOther">Other</label>
                    </div>
                </div>

                <div id="cancelReasonOtherArea" style="display: none;">
                    <label class="small font-weight-bold text-muted mb-1 text-uppercase">Specify Other Reason</label>
                    <textarea id="txtCancelReasonOther" class="form-control border-primary" rows="2" placeholder="Enter details..."></textarea>
                </div>
            </div>
            <div class="modal-footer bg-light p-2">
                <button type="button" class="btn btn-secondary btn-sm font-weight-bold" data-dismiss="modal">CLOSE</button>
                <button type="button" class="btn btn-danger btn-sm px-4 font-weight-bold" id="btnConfirmCancellation">CONFIRM CANCELLATION</button>
            </div>
        </div>
    </div>
</div>


<script>
    var guardRosterStartDate = null;
    var currentGuardSiteId = null;
    var loggedGuardId = null;
    var isAdminRoster = false;
    var isAdminFinancialsOn = false;
    var isAdminSupplierOn = false;
    var adminRateType = 'guard'; // 'guard' or 'sell'
    var currentRosterStatus = 'Live';
    var lastGuardRosterData = null;
    
    // Public Holiday Orange Sun SVG
    const phIconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512" style="width: 16px; height: 16px; fill: #FFA500; vertical-align: middle; margin-left: 4px;"><path d="M608 384h-141.2c-7.1 0-14.1-2.1-20.1-6.1L382.5 335.1l-64.2-42.8L192 384H32c-17.7 0-32-14.3-32-32s14.3-32 32-32h155.6l69.8-46.5c10.3-6.9 23.9-6.9 34.2 0l64.4 42.9 85.5 28.5H608c17.7 0 32 14.3 32 32s-14.3 32-32 32zM32 448c-17.7 0-32-14.3-32-32s14.3-32 32-32h576c17.7 0 32 14.3 32 32s-14.3 32-32 32H32zM280.4 224l-59.3-59.3-59.3 59.3 59.3 59.3 59.3-59.3zM256 0c-43.8 0-82.6 25.1-102.3 62.4l-31.1-10.4c-8.4-2.8-17.5 1.7-20.3 10.1s1.7 17.5 10.1 20.3l31.1 10.4c.1 3.5.3 7 1.1 10.4 12.4 56.6 62.1 98.8 121.4 98.8s109-42.2 121.4-98.8c.8-3.5.9-7 1.1-10.4l31.1-10.4c8.4-2.8 12.9-11.9 10.1-20.3s-11.9-12.9-20.3-10.1l-31.1 10.4C338.6 25.1 299.8 0 256 0z"/></svg>`;

    $(document).ready(function() {
        $('#btnPrevWeekGuard').on('click', function() {
            var parts = guardRosterStartDate.split('-');
            var d = new Date(parts[0], parts[1] - 1, parts[2]);
            d.setDate(d.getDate() - 7);
            guardRosterStartDate = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
            loadGuardRoster();
            if (isAdminRoster) loadAdminRosterStatus();
        });

        $('#btnNextWeekGuard').on('click', function() {
            var parts = guardRosterStartDate.split('-');
            var d = new Date(parts[0], parts[1] - 1, parts[2]);
            d.setDate(d.getDate() + 7);
            guardRosterStartDate = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
            loadGuardRoster();
            if (isAdminRoster) loadAdminRosterStatus();
        });

        $('#btnDownloadGuardPdf').on('click', function() {
            $('#guardDownloadFilterModal').modal('show');
        });

        $('#btnConfirmGuardDownload').on('click', function() {
            var weeks = $('#guardPdfWeeks').val();
            var status = currentRosterStatus; // Send the status regardless of role
            var url = '/roster/GuardRosterAction?handler=DownloadSiteRosterPdf' + 
                '&siteId=' + currentGuardSiteId + 
                '&startDate=' + guardRosterStartDate + 
                '&weeks=' + weeks + 
                '&includeFinancials=' + isAdminFinancialsOn + 
                '&rateType=' + adminRateType + 
                '&status=' + status +
                '&includeSuppliers=' + isAdminSupplierOn;
            window.open(url, '_blank');
            $('#guardDownloadFilterModal').modal('hide');
        });

        // Admin Toggles
        $('#adminFinancialToggle').on('change', function() {
            isAdminFinancialsOn = $(this).is(':checked');
            $('#adminRateTypeSwitch').prop('disabled', !isAdminFinancialsOn);
            if (!isAdminFinancialsOn) {
                $('#adminRateTypeSwitch').prop('checked', false);
                adminRateType = 'guard';
            }
            checkRemunerationVisibility();
