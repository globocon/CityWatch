        margin-right: 8px;
        border: 1px solid rgba(255,255,255,0.2);
    }
    
    /* Table Styling matched to Booking module */
    #guard_roster_grid { border-collapse: separate; border-spacing: 0; }
    
    #guard_roster_grid thead th {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
