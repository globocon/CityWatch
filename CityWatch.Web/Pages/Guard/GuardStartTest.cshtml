                <div class="col-md-12 text-center text-danger">

                                    <h3>Comming Soon! </h3>

                </div>

            </div>
        </div>
        <div class="card-footer d-flex justify-content-end">
            <button class="btn btn-primary col-md-2" id="btnExitCourse" >Exit</button>
        </div>
    </div>
</div>
}
else
