<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 2GB limit in bytes: 2147483648 -->
        <requestLimits maxAllowedContentLength="2147483648" />
      </requestFiltering>
    </security>
  </system.webServer>
  <system.web>
    <!-- 2GB limit in KB: 2097152 -->
    <httpRuntime maxRequestLength="2097152" />
  </system.web>
</configuration>
