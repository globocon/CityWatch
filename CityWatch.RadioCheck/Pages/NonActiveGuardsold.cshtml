                            <th>Address</th>
                            <th>Site Name/Guard</th>
                            <th>Last Login Date</th>

                        </tr>
                    </thead>
                    <tfoot>
                        <tr>
                            <th>ClientSiteId</th>
                            <th>Site Name</th>
                            <th>Address</th>
                            <th>Site Name/Guard</th>
                            <th>Last Login Date</th>

                        </tr>
                        <!-- Footer content here (will be styled to look like the header) -->
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>


@Html.AntiForgeryToken()
<partial name="_RadioCheckListModels" />
@section PageHeader {
    <h3 class="text-center">NON ACTIVE GUARDS</h3>
}