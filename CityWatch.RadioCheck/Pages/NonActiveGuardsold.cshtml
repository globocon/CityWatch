@page

@model CityWatch.Web.Pages.Radio.NonActiveGuardsModel
@{
    ViewData["Title"] = "Non Available Guards";
    ViewData["PageName"] = "Non Available Guards";
}
<div id="rcloader"></div>
@*----------------Hidden Inputs---------------------*@
<input type="hidden" id="txtClientSiteId" />
<input type="hidden" id="txtGuardId" />
<!-----------------In Acive List -------------------->

<div class="card">
    <h4 class="card-header">Not Available</h4>
    <div class="card-body" id="events-list">
        <div class="row mt-2">
            <div class="col-md-12">
                <table id="clientSiteNotAvailableGuards" class="table table-bordered" style="width:100%;">
