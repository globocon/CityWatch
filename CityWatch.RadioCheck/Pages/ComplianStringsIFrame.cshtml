    @if (Model.TableData != null)
    {


        var dataRows = Model.TableData.Skip(1);

        int fy25Compliant = dataRows.Count(row => row[0] == "FY25" && row[5].Equals("Y", StringComparison.OrdinalIgnoreCase));
        int fy27Compliant = dataRows.Count(row => row[0] == "FY27" && row[5].Equals("Y", StringComparison.OrdinalIgnoreCase));
        int fy27Quarantine = dataRows.Count(row => row[0] == "FY27" && row[5].Equals("N", StringComparison.OrdinalIgnoreCase));

        <div class="d-flex justify-content-start">
            <div style="width: 25%; background-color: #104861; color: white; padding: 0.75rem; font-size: 0.9rem; ">
                <div class="row mb-1 flex-nowrap">
                    <div class="col-auto fw-bold">FY25</div>
                    <div class="col">Compliant</div>
                    <div class="col text-end fw-bold">@fy25Compliant</div>
                </div>
                <div class="row mb-1 flex-nowrap">
                    <div class="col-auto fw-bold">FY27</div>
                    <div class="col">Compliant</div>
                    <div class="col text-end fw-bold">@fy27Compliant</div>
                </div>
                <div class="row mb-1 flex-nowrap">
                    <div class="col-auto fw-bold">FY27</div>
                    <div class="col">Quarantine</div>
                    <div class="col text-end fw-bold">@fy27Quarantine</div>
                </div>
            </div>
        </div>



        <div class="table-responsive" style="font-size: 0.72rem;width:98%">

            <div class="d-flex justify-content-start">
                <div style="width: 10%; background-color: #104861; color: white; padding: 0.5rem; font-size: 0.9rem; border-radius: 5px;">
                    <label class="fw-bold">Filter by Build FY:</label>
                    <select id="fyFilter" class="form-select form-select-sm w-100 mt-1">
                        <option value="">All</option>
                        <option value="FY25">FY25</option>
                        <option value="FY26">FY26</option>
                        <option value="FY27">FY27</option>
                        <option value="FY28">FY28</option>
                        <option value="FY29">FY29</option>
                        <option value="FY30">FY30</option>
                    </select>
                </div>
            </div>

            <table id="compliantTable" class="table table-bordered table-striped table-hover table-sm bg-white text-dark" style="width: 98%;">
                <thead style="background-color: #104861; color: white;">
                    <tr>
                        <th colspan="8" class="text-center fw-bold border">STRING DATA</th>
                        <th colspan="@(Model.TableData[0].Count - 8)" class="text-center fw-bold border">DEFECTIVE AND NEW WELD DATA</th>
                        <th rowspan="2" class="text-center fw-bold border align-middle">Action</th>
                    </tr>
                    <tr style="background-color: #104861; color: white;">
                        @foreach (var header in Model.TableData[0])
                        {
                                                         <th class="fw-bold border text-center rotate-vertical sorting">
                    <div class="rotate-text">@header</div>
                </th>
                        }
                    </tr>
                </thead>
                <tbody class="text-dark">
                    @for (int i = 1; i < Model.TableData.Count; i++)
                    {
                        <tr>
                            @foreach (var cell in Model.TableData[i])
                            {
                                <td class="border text-center">@cell</td>
                            }
                            <td class="text-center border">
                                <input type="hidden" name="rowIndex" value="@i" />
                                <button type="button" class="btn btn-sm btn-danger" title="Delete" onclick="deleteRow(@i)">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    }
    else
    {
        <p>No data found or file missing.</p>
    }





    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>



    <script>
        function deleteRow(rowIndex) {
            if (!confirm("Are you sure you want to remove this row?")) return;

            $.ajax({
                url: 'ComplianStringsIFrame?handler=DeleteRow',
                type: 'POST',
                dataType: 'json',
                data: { rowIndex: rowIndex },
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() }
            }).done(function (response) {
                if (response) {
                    $("button[onclick='deleteRow(" + rowIndex + ")']").closest("tr").remove();
                }
            });
        }

              $(document).ready(function () {
            var table = $('#compliantTable').DataTable({
                dom: 'Bfrtip',
                paging: false,
                info: false,
                scrollX: true,
                responsive: false, // ⚠️ turn off if multi-header table isn't aligning
                autoWidth: false,
                order: [[0, 'asc']],
                autoWidth: false,                
                buttons: [
                    {
                        extend: 'excel',
                        text: 'Export to Excel',
                        className: 'btn btn-success btn-sm me-1'
                    },
                    {
                        extend: 'pdf',
                        text: 'Export to PDF',
                        className: 'btn btn-danger btn-sm me-1'
                    },
                    {
                        extend: 'print',
                        text: 'Print',
                        className: 'btn btn-info btn-sm'
                    }
                ]
            });

            // ✅ Force re-alignment after a short delay
            setTimeout(() => {
                table.columns.adjust().draw(false);
            }, 200);

                      $('#fyFilter').on('change', function () {
            let selectedFY = $(this).val();

            // Clear all existing filters first
            table.search('').columns().search('');

            if (selectedFY) {
                // Apply exact match filter to Build FY column
                table.column(0).search('^' + selectedFY + '$', true, false).draw();
            } else {
                // Just draw the full table
                table.draw();
            }
        });



        });




    </script>
</body>
</html>
