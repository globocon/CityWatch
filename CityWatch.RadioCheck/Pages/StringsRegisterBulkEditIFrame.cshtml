    @if (Model.TableData != null)
    {
   

        var dataRows = Model.TableData.Skip(1); // Skip header row

        // Group rows by FY and calculate Compliant and Quarantine counts
        var fyGroups = dataRows
        .GroupBy(row => row[0]) // Assuming FY is in column 0
        .Select(g => new
        {
            FY = g.Key,
            CompliantCount = g.Count(row => row[5].Equals("Y", StringComparison.OrdinalIgnoreCase)), // Column 5 for compliance
            QuarantineCount = g.Count(row => row[5].Equals("N", StringComparison.OrdinalIgnoreCase))
        })
        .OrderBy(g => g.FY) // Optional: sort by FY
        .ToList();

        <div class="d-flex justify-content-between align-items-start" style="background-color: #104861; color: white; padding: 0.75rem; font-size: 0.9rem;">
            <div class="container mt-3" style="width: 30%;">
                <div class="row fw-bold text-white bg-primary py-2">
                    <div class="col">FY</div>
                    <div class="col text-center">Compliant</div>
                    <div class="col text-center">Quarantine</div>
                </div>

                @foreach (var fy in fyGroups)
                {
                    <div class="row border-bottom py-2">
                        <div class="col fw-bold">@fy.FY</div>
                        <div class="col text-center">@fy.CompliantCount</div>
                        <div class="col text-center">@fy.QuarantineCount</div>
                    </div>
                }
            </div>
            <div style="width: 50%;">
            </div>
            <!-- Right Side: Button -->
            <div class="text-end" style="width: 20%;">
                <button type="button" class="btn btn-success btn-sm" onclick="bulkUpdate()">
                    <i class="fa fa-save"></i> Bulk Update DROP DATA
                </button>
            </div>
        </div>


        <div class="table-responsive" style="font-size: 0.72rem;width:98%">
            <div class="d-flex justify-content-start">
                <div style="width: 10%; background-color: #104861; color: white; padding: 0.5rem; font-size: 0.9rem; border-radius: 5px;">
                    <label class="fw-bold">Filter by Build FY:</label>
                    <select id="fyFilter" class="form-select form-select-sm w-100 mt-1">
                        <option value="">All</option>
                        @foreach (var fy in Model.TableData.Skip(1).Select(row => row[0]).Distinct().OrderBy(fy => fy))
                        {
                            <option value="@fy">@fy</option>
                        }
                    </select>
                </div>
            </div>

            <table id="compliantTable" class="table table-bordered table-striped table-hover table-sm bg-white text-dark" style="width: 98%;">
              @*   <thead style="background-color: #104861; color: white;">
                    <tr>
                        <th colspan="8" class="text-center fw-bold border">STRING DATA</th>
                        <th colspan="@(Model.TableData[0].Count - 8)" class="text-center fw-bold border">DEFECTIVE AND NEW WELD DATA</th>
                        <th rowspan="2" class="text-center fw-bold border align-middle">Action</th>
                    </tr>
                    <tr style="background-color: #104861; color: white;">
                        @foreach (var header in Model.TableData[0])
