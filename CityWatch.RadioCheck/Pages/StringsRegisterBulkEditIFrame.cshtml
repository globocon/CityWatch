.rotate-vertical {
    height: 150px !important;
    vertical-align: middle !important;
    padding: 0 !important;
    white-space: nowrap !important;
    text-align: center !important;
    position: relative !important;
}

.rotate-text {
    writing-mode: vertical-rl !important;          /* flows bottom to top */
    transform: rotate(180deg) !important;          /* flips text to top-to-bottom */
    transform-origin: center center !important;
    display: inline-block !important;
    position: absolute !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) rotate(180deg) !important; /* center horizontally and vertically */
    font-weight: bold !important;
}

#compliantTable thead {
  visibility: hidden;
}
#compliantTable thead th {
  padding: 0 !important;
  height: 0 !important;
  line-height: 0 !important;
  border: none !important;
  background: transparent !important;
  font-size: 0 !important;
}

#compliantTable {
    table-layout: fixed !important;
    width: 100% !important;
}

table th,
table td {
    /*width: 200px !important;*/
   /* min-width: 75px !important;*/
    /*max-width: 75px !important;*/
    white-space: normal !important;      /* allow text to wrap */
    overflow: visible !important;        /* show overflow */
    text-overflow: unset !important;     /* don't trim with ... */
    text-align: center !important;
    vertical-align: middle !important;
    padding: 4px !important;
    word-wrap: break-word !important;    /* wrap long words */
}


/* For DataTables compatibility */
.dataTables_scrollHead table,
.dataTables_scrollBody table {
    table-layout: fixed !important;
}
  </style>


