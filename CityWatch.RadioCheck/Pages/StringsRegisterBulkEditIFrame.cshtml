                <thead style="background-color: #104861; color: white;">
                    <tr>
                        <th colspan="8" class="text-center fw-bold border">STRING DATA</th>
                        <th colspan="4" class="text-center fw-bold border">DEFECTIVE AND NEW WELD DATA</th>
                        <th colspan="4" class="text-center fw-bold border">DROP DATA</th>
                        <th rowspan="2" class="text-center fw-bold border align-middle">Action</th>
                    </tr>
                    <tr>
                        @for (int i = 0; i < Model.TableData[0].Count; i++)
                        {
                            <th class="fw-bold border text-center rotate-vertical sorting">
                                <div class="rotate-text">@Model.TableData[0][i]</div>
                            </th>
                        }

                     
                    </tr>
                </thead>

                
                <tbody class="text-dark">
                    @for (int i = 1; i < Model.TableData.Count; i++)
                    {
                        <tr>
                            @for (int j = 0; j < Model.TableData[i].Count; j++)
                            {
                                <td class="border text-center">
                                    @if (j >= Model.TableData[i].Count - 4)
                                    {
                                        var value = Model.TableData[i][j];

                                        // For the first of the last 4 columns, render date input
                                        if (j == Model.TableData[i].Count - 4)
                                        {
                                            @* DateTime parsedDate;
                                            string formattedDate = DateTime.TryParse(value, out parsedDate)
                                            ? parsedDate.ToString("yyyy-MM-dd")
                                            : ""; *@


                                            DateTime parsedDate;
                                            string formattedDate = DateTime.TryParseExact(
                                            value,
                                            "dd-MM-yyyy",
                                            CultureInfo.InvariantCulture,
                                            DateTimeStyles.None,
                                            out parsedDate
                                            ) ? parsedDate.ToString("yyyy-MM-dd") : "";

                                            <input type="date"
                                                   class="form-control form-control-sm text-center"
                                                   value="@formattedDate"
                                                   data-row="@i"
                                                   data-col="@j"
                                                   onchange="formatDate(this)" />
                                        }
                                        else
                                        {
                                            <input type="text"
                                                   class="form-control form-control-sm text-center"
                                                   value="@value"
                                                   data-row="@i"
                                                   data-col="@j" />
                                        }
                                    }
                                    else
                                    {
                                        @Model.TableData[i][j]
                                    }
                                </td>
                            }

                            <td class="text-center border">
                                <input type="hidden" name="rowIndex" value="@i" />
                                <button type="button" class="btn btn-sm btn-primary update-row-btn" data-row-index="@i"><i class="fa fa-pencil"></i></button>
                                <button type="button" class="btn btn-sm btn-danger" title="Delete" onclick="deleteRow(@i)">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>



            </table>

        </div>
    }
    else
    {
        <p>No data found or file missing.</p>
    }





    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>



    <script>


                function formatDate(input) {
            const value = input.value;
            if (!value) return;

            const date = new Date(value);
            if (!isNaN(date)) {
                const day = String(date.getDate()).padStart(2, '0');
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const year = date.getFullYear();

                // Optional: Switch to text and format visually as dd-MM-yyyy
                input.type = 'text';
                input.value = `${day}-${month}-${year}`;
            }
        }
        function deleteRow(rowIndex) {
            if (!confirm("Are you sure you want to remove this row?")) return;

            $.ajax({
                url: 'StringsRegisterBulkEditIFrame?handler=DeleteRow',
                type: 'POST',
                dataType: 'json',
                data: { rowIndex: rowIndex },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                }
            }).done(function (response) {
                if (response) {
                    $("button[onclick='deleteRow(" + rowIndex + ")']").closest("tr").remove();
                }
            });
        }

        $(document).ready(function () {
            var table = $('#compliantTable').DataTable({
                dom: 'Bfrtip',
                paging: false,
                info: false,
                scrollX: true,
                responsive: false,
                autoWidth: false,
                order: [[0, 'asc']],
                buttons: [
                    {
                        extend: 'excel',
                        text: 'Export to Excel',
                        className: 'btn btn-success btn-sm me-1'
                    },
                    {
                        extend: 'pdf',
                        text: 'Export to PDF',
                        className: 'btn btn-danger btn-sm me-1'
                    },
                    {
                        extend: 'print',
                        text: 'Print',
                        className: 'btn btn-info btn-sm'
                    }
                ]
            });

            setTimeout(() => {
                table.columns.adjust().draw(false);
            }, 200);

            $('#fyFilter').on('change', function () {
                let selectedFY = $(this).val();

                table.search('').columns().search('');
                if (selectedFY) {
                    table.column(0).search('^' + selectedFY + '$', true, false).draw();
                } else {
                    table.draw();
                }
            });
        });

               window.bulkUpdate = function () {
        const dropDataRows = [];

               $('#compliantTable tbody tr').each(function () {
            const rowData = [];

            // Collect the first 4 input values regardless of type
            $(this).find('input').slice(0, 4).each(function () {
                rowData.push($(this).val()?.trim() || "");
            });

            // Ensure exactly 4 items (just in case)
            while (rowData.length < 4) {
                rowData.push("");
            }

            dropDataRows.push(rowData.join(','));
        });


            if (dropDataRows.length === 0) {
            alert("No text inputs found for update.");
            return;
        }

            const dropDataString = dropDataRows.join('|'); // Example: data11,data12|data21,data22|...

            fetch("StringsRegisterBulkEditIFrame?handler=BulkUpdate", {
                method: "POST",
                headers: {
                    "Content-Type": "text/plain", // sending raw string, not JSON
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                body: dropDataString // just the plain string
            })
            .then(res => res.text())
            .then(response => {
                alert("Bulk update successful");
                location.reload();
            })
            .catch(error => {
                console.error("Bulk update failed:", error);
            });
        };


                $(document).on('click', '.update-row-btn', function () {
              var $button = $(this);
        var rowIndex = $button.data('row-index'); 

        var $row = $button.closest('tr');
        var rowData = [];

        $row.find('input').slice(0, 4).each(function () {
            rowData.push($(this).val()?.trim() || "");
        });

        rowData.push(rowIndex); // add rowIndex at end


            $.ajax({
                url: '?handler=UpdateRow',
                method: 'POST',
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                data: {
                    rowIndex: rowIndex,
                    col1: rowData[0],
                    col2: rowData[1],
                    col3: rowData[2],
                    col4: rowData[3]
                },
                success: function (response) {
                    if (response.success) {
                        alert("Row updated successfully.");
                        location.reload();
                    } else {
                        alert("Update failed: " + response.message);
                    }
                },
                error: function () {
                    alert("Server error occurred.");
                }
            });
        });
               
        
    </script>






    
</body>
</html>
