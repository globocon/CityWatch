<!-- CustomWand Schedule Modal -->
<div class="modal" tabindex="-1" role="dialog" id="customWands-schedule-modal" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa fa-calendar" aria-hidden="true"></i> Manage Custom Wands Schedule</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-2">
                <form id="frm_kpi_CustomWandSchedule">
                    <input type="hidden" id="CustomWandscheduleId" name="id" value="0">
                    <input type="hidden" id="nextRunOnCustomWand" name="nextRunOn" value="">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="clientTypeName">Client Type</label>
                                <select class="form-control" id="clientTypeNameCustomWand" name="clientTypeName" asp-items="@Model.ViewDataService.ClientTypesUsingLoginMainUserId(Model.userId)"></select>
                            </div>
                            <div class="form-group">
                                <label for="clientSites">Client Site</label>
                                <select class="form-control" id="clientSitesCustomWand" name="clientSites">
                                    <option>Select</option>
                                    <option value="-1">Select All</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="selectedSites">Selected Client Sites <span class="badge badge-pill badge-info" id="selectedSitesCountCustomWand">0</span></label>
                                <select class="form-control" id="selectedSitesCustomWand" name="selectedSites" multiple style="height: 220px"></select>
                                <button type="button" class="btn btn-sm btn-outline-primary mt-2" id="editSelectedSiteCustomWand" title="Edit selected sites from the list"><i class="fa fa-pencil mr-2"></i>Edit Site</button>
                                <button type="button" class="btn btn-sm btn-outline-danger mt-2" id="removeSelectedSitesCustomWand" title="Remove selected sites from the list"><i class="fa fa-trash-o mr-2"></i>Remove Sites</button>
                            </div>

                            <div style="border: solid;border-color: grey;border-width: thin;" class="p-1">
                                <label class="col-form-label">Excel Report Type</label>
                                <div class="form-group row align-items-center">
                                    <div class="col-md-12 d-flex align-items-center">
                                        <div class="form-check mr-5">
                                            <input type="checkbox" class="form-check-input" id="chk_CustomWandReportType_Site" />
                                            <label for="chk_CustomWandReportType_Site" id="lbl_CustomWandReportType_Site" class="form-check-label">Site</label>
                                        </div>

                                        <div class="form-check mr-5">
                                            <input type="checkbox" class="form-check-input" id="chk_CustomWandReportType_MonSun" />
                                            <label for="chk_CustomWandReportType_MonSun" id="lbl_CustomWandReportType_MonSun" class="form-check-label">Mon - Sun</label>
                                        </div>

                                        <div class="form-check mr-5">
                                            <input type="checkbox" class="form-check-input" id="chk_CustomWandReportType_All" />
                                            <label for="chk_CustomWandReportType_All" id="lbl_CustomWandReportType_All" class="form-check-label">Both</label>
                                        </div>
                                    </div>
                                    <input type="hidden" id="CustomWandReportType" name="CustomWandReportType">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="startDate">Start Date</label>
                                <input type="date" class="form-control" id="startDateCustomWand" name="startDate">
                            </div>
                            <div class="form-group">
                                <label for="endDate">End Date</label>
                                <input type="date" class="form-control" id="endDateCustomWand" name="endDate">
                            </div>
                            <div class="form-group">
                                <label for="frequency">Frequency</label>
                                <select class="form-control" id="CustomWandfrequency" name="frequency">
                                    <option value="">Select</option>
                                    <option value="0">Daily</option>
                                    <option value="1">Weekly</option>
                                    <option value="2">Monthly</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="time">Exec. Time</label>
                                <input type="time" class="form-control" id="CustomWandtime" name="time">
                            </div>
                            <div class="form-group">
                                <label for="emailTo">Email Recipients [CC] <i class="fa fa-info-circle text-info" title="Comma separated list of additional email recipients in CC"></i></label>
                                <textarea class="form-control" id="emailToCustomWand" name="emailTo" rows="3"></textarea>
                            </div>
                            <div class="form-group">
                                <label for="emailTo">Email Recipients [BCC] <i class="fa fa-info-circle text-info" title="Comma separated list of additional email recipients in BCC"></i></label>
                                <textarea class="form-control" id="emailBccCustomWand" name="emailBcc" rows="3"></textarea>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="projectName">Project Name</label>
                                <input type="text" class="form-control" id="projectNameCustomWand" name="projectName" maxlength="50" />
                            </div>

                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <ul id="sch-modal-validation-CustomWand" class="text-danger hide"></ul>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <button type="button" id="btnSaveCustomWandSchedule" class="btn btn-primary"><i class="fa fa-save mr-2"></i>Save Schedule</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal" tabindex="-1" role="dialog" id="run-customWands-schedule-modal" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Run Schedule</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="form-group">
                        <div class="form-row">
                            <div class="form-group col-md-12">
                                <label class="mx-1" for="reportRunDateCustomWand">Select Report Date</label>
                                <input type="date" class="form-control" id="reportRunDateCustomWand" name="reportRunDateCustomWand" max="@DateTime.Now.ToString("yyyy-MM-dd")">
                            </div>
                        </div>
                    </div>
                    <div class="form-group mb-0">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="cbIgnoreRecipientsCustomWands">
                            <label class="form-check-label" for="cbIgnoreRecipientsCustomWands">
                                Ignore email recipients (CC & BCC)?
                            </label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer d-flex flex-column align-items-start">
                <input type="hidden" value="" name="sch-id-CustomWands" id="sch-id-CustomWands" />
                <div class="btn-toolbar">
                    <button type="button" class="btn btn-primary mr-3" id="btnScheduleRunCustomWands">Run Now</button>
                    <button type="button" id="btnScheduleDownloadCustomWands" class="btn btn-outline-primary ml-4"><i class="fa fa-download"></i> Download Now</button>
                </div>
                <span id="schRunStatusCustomWands" class="mt-2"></span>
            </div>
        </div>
    </div>
</div>

