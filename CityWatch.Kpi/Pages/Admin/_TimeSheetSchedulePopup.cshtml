<div class="modal" tabindex="-1" role="dialog" id="pcar-modal" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header py-2 position-relative">
                <h5 class="modal-title mb-0"><i class="fa fa-calendar" aria-hidden="true"></i> Manage PCAR Routes</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="position:absolute; top:8px; right:10px;">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body p-2">
                <!-- Tabs -->
                <ul class="nav nav-tabs small" id="scheduleEditTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a class="nav-link active py-1" id="scheduleSettingsTab" data-toggle="tab" href="#pcarsiteScheduleSettings" role="tab" aria-controls="pcarsiteScheduleSettings" aria-selected="true">PCAR Routes</a>
                    </li>
                </ul>

                <div class="tab-content p-1">
                    <div class="tab-pane active" id="pcarsiteScheduleSettings" role="tabpanel" aria-labelledby="scheduleSettingsTab">

                        <form id="frm_pcar_Timesheetschedule">
                            <input type="hidden" id="TimeSheetscheduleIdpcr" name="id" value="0">
                            <input type="hidden" id="nextRunOnTimesheet" name="nextRunOn" value="">

                            <!-- PCAR Basic Details -->
                            <!-- PCAR Route Name and Smart Wand Allocation -->
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <div class="form-group mb-1">
                                        <label class="small mb-0">PCAR Route Name</label>
                                        <input type="text" class="form-control form-control-sm" id="pcarroutename" name="pcarroutename" maxlength="50" />
                                    </div>
                                </div>

                                <div class="col-md-4 d-flex align-items-end gap-2">
                                    <div class="flex-grow-1">
                                        <div class="form-group mb-1">
                                            <label class="small mb-0">PCAR Smart Wand Allocation</label>
                                            <select class="form-control form-control-sm" id="smartwandallocation" name="smartwandallocation">
                                                @foreach (var wand in Model.ViewDataService.getSmartWandForTourmodel())
                                                {
                                                    <option value="@wand.Value">@wand.Text</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <!-- Button right of the dropdown -->
                                    <button type="button" id="btnCreatePcarProfile" class="btn btn-sm btn-success mb-1 ml-2">
                                        <i class="fa fa-plus mr-1"></i>Create Profile
                                    </button>
                                </div>

                            </div>


                            <hr class="my-1">

                            <!-- PCAR Route Details Panel -->
                            <div class="card mt-1" id="pcar-bottom-section" style="pointer-events:none; opacity:0.4;">
                                <div class="card-header bg-primary text-white py-1 d-flex justify-content-between align-items-center">
                                    <strong class="mb-0 small">PCAR Route Details</strong>
                                    <button class="btn btn-sm btn-light py-0 px-2 d-flex align-items-center"
                                            type="button" data-toggle="collapse"
                                            data-target="#pcar-panel-body"
                                            aria-expanded="true"
                                            aria-controls="pcar-panel-body">
                                        <i class="fa fa-chevron-down toggle-icon"></i>
                                    </button>

                                </div>

                                <div class="collapse show" id="pcar-panel-body">
                                    <div class="card-body p-2">

                                        <!-- Client Type & Sites -->
                                        <div class="row g-2 align-items-end">
                                            <div class="col-md-4">
                                                <div class="form-group mb-1">
                                                    <label class="small mb-0">Client Type</label>
                                                    <select class="form-control form-control-sm" id="clientTypeNameTimesheetpcr" name="clientTypeName" asp-items="@Model.ViewDataService.ClientTypesUsingLoginMainUserId(Model.userId)"></select>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group mb-1">
                                                    <label class="small mb-0">Client Site</label>
                                                    <select class="form-control form-control-sm" id="clientSitesTimesheetPCR" name="clientSites"></select>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <button type="button" class="btn btn-sm btn-success mb-1" id="btnAddSiteToPcarRoute">
                                                    <i class="fa fa-plus mr-1"></i>Add Site to Route
                                                </button>
                                            </div>
                                        </div>

                                        <hr class="my-1">

                                        <!-- Container for dynamic site blocks -->
                                        <div id="pcar-sites-container" class="mb-2" style="max-height: 500px; overflow-y: auto; overflow-x: hidden;">
                                            <!-- Site blocks will be rendered here -->
                                        </div>

                                        <hr class="my-1">

                                        <!-- Validation & Save -->
                                        <div class="row g-1">
                                            <div class="col-md-12">
                                                <ul id="sch-modal-validation1" class="text-danger small mb-1 hide"></ul>
                                            </div>
                                            <div class="col-md-12">
                                                <button type="button" id="btnSavePcCarrute" class="btn btn-sm btn-primary py-1 px-2"><i class="fa fa-save mr-1"></i>Save PCAR Routes</button>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



