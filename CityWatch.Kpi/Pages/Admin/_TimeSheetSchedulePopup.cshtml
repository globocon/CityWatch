                                        <textarea class="form-control" id="emailBcckv" name="emailBcc" rows="3"></textarea>
                                    </div>

                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="projectNamekv">Project Name</label>
                                        <input type="text" class="form-control" id="projectNamekv" name="projectName" maxlength="50" />
                                    </div>
                                    <div class="form-group">
                                        <label>ID No. / Car or Truck Rego.</label>
                                        <input type="text" class="form-control" id="VehicleRegokv" name="VehicleRego" />
                                    </div>
                                    <div class="form-group">
                                        <label>Company Name</label>
                                        <select class="form-control" id="CompanyNamekv" name="CompanyName">
