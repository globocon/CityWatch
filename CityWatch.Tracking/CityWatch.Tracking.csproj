<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The feature pack references CityWatch.Events only. It must never reference
       CityWatch.Data: the platform's data layer cannot be allowed to become reachable
       from the tracking hot path, and the dependency arrow must always point from the
       host applications inward, never between modules. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="7.0.15" />
    <!-- FCM push nudge (§Push). Targets net6.0/netstandard2.0 — verified against
         nuget.org for net7.0 compatibility 12 Aug 2026. The service-account key it
         reads lives OUTSIDE the repo and site folder (Tracking:Fcm config). -->
    <PackageReference Include="FirebaseAdmin" Version="3.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CityWatch.Events\CityWatch.Events.csproj" />
  </ItemGroup>

</Project>
